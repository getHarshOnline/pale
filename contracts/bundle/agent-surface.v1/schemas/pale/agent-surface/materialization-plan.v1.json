{
  "$defs": {
    "ExistingMachineLocalFileV1": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/$defs/MachineLocalFileIdentityV1"
        },
        "mode": {
          "$ref": "#/$defs/UnixFileMode"
        },
        "sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        }
      },
      "required": [
        "sha256",
        "mode",
        "identity"
      ],
      "type": "object"
    },
    "FilesystemDeviceIdV1": {
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$",
      "type": "string"
    },
    "FilesystemInodeIdV1": {
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$",
      "type": "string"
    },
    "MachineLocalDirectoryIdentity": {
      "additionalProperties": false,
      "properties": {
        "device": {
          "$ref": "#/$defs/FilesystemDeviceIdV1"
        },
        "inode": {
          "$ref": "#/$defs/FilesystemInodeIdV1"
        },
        "rel_path": {
          "type": "string"
        }
      },
      "required": [
        "rel_path",
        "device",
        "inode"
      ],
      "type": "object"
    },
    "MachineLocalEffectKind": {
      "oneOf": [
        {
          "const": "git_exclude_protection",
          "type": "string"
        }
      ]
    },
    "MachineLocalEffectTransitionV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "create",
              "type": "string"
            },
            "create_directories": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "post": {
              "$ref": "#/$defs/PlannedFileV1"
            }
          },
          "required": [
            "action",
            "post",
            "create_directories"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "update",
              "type": "string"
            },
            "post": {
              "$ref": "#/$defs/PlannedFileV1"
            },
            "prior": {
              "$ref": "#/$defs/ExistingMachineLocalFileV1"
            }
          },
          "required": [
            "action",
            "prior",
            "post"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "splice",
              "type": "string"
            },
            "post": {
              "$ref": "#/$defs/PlannedFileV1"
            },
            "prior": {
              "$ref": "#/$defs/ExistingMachineLocalFileV1"
            }
          },
          "required": [
            "action",
            "prior",
            "post"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "unchanged",
              "type": "string"
            },
            "state": {
              "$ref": "#/$defs/ExistingMachineLocalFileV1"
            }
          },
          "required": [
            "action",
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "delete",
              "type": "string"
            },
            "prior": {
              "$ref": "#/$defs/ExistingMachineLocalFileV1"
            }
          },
          "required": [
            "action",
            "prior"
          ],
          "type": "object"
        }
      ]
    },
    "MachineLocalEffectV1": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/MachineLocalEffectKind"
        },
        "rel_path": {
          "type": "string"
        },
        "retained_directories": {
          "items": {
            "$ref": "#/$defs/MachineLocalDirectoryIdentity"
          },
          "type": "array"
        },
        "root": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/machine-local-root-identity.v1.json"
        },
        "transition": {
          "$ref": "#/$defs/MachineLocalEffectTransitionV1"
        }
      },
      "required": [
        "kind",
        "root",
        "rel_path",
        "retained_directories",
        "transition"
      ],
      "type": "object"
    },
    "MachineLocalFileIdentityV1": {
      "additionalProperties": false,
      "properties": {
        "device": {
          "$ref": "#/$defs/FilesystemDeviceIdV1"
        },
        "inode": {
          "$ref": "#/$defs/FilesystemInodeIdV1"
        }
      },
      "required": [
        "device",
        "inode"
      ],
      "type": "object"
    },
    "PlannedFileV1": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/UnixFileMode"
        },
        "sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        }
      },
      "required": [
        "sha256",
        "mode"
      ],
      "type": "object"
    },
    "UnixFileMode": {
      "format": "uint32",
      "maximum": 4095,
      "minimum": 0,
      "type": "integer"
    }
  },
  "$id": "https://www.rawthoughts.in/pale/schemas/materialization-plan.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "machine_local_effects": {
      "items": {
        "$ref": "#/$defs/MachineLocalEffectV1"
      },
      "type": "array"
    },
    "one_shot_compilation_digest": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "plan_digest": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "schema": {
      "const": "pale.materialization-plan.v1",
      "type": "string"
    },
    "schema_manifest_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "schema_set_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "schema_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "schema_version": {
      "const": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "surface_plan": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/agent-surface-plan.v1.json"
    }
  },
  "required": [
    "schema",
    "schema_sha256",
    "schema_version",
    "schema_manifest_sha256",
    "schema_set_sha256",
    "one_shot_compilation_digest",
    "surface_plan",
    "machine_local_effects",
    "plan_digest"
  ],
  "title": "materialization-plan.v1",
  "type": "object"
}
