<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0.22em" rspace="0.22em"><mo>+</mo><mtext> ⁣</mtext><mo>+</mo></mo><mi>b</mi><mo stretchy="false">)</mo><mo lspace="0.22em" rspace="0.22em"><mo>+</mo><mtext> ⁣</mtext><mo>+</mo></mo><mi>c</mi><mo>=</mo><mi>a</mi><mo lspace="0.22em" rspace="0.22em"><mo>+</mo><mtext> ⁣</mtext><mo>+</mo></mo><mo stretchy="false">(</mo><mi>b</mi><mo lspace="0.22em" rspace="0.22em"><mo>+</mo><mtext> ⁣</mtext><mo>+</mo></mo><mi>c</mi><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><mi>ε</mi><mo lspace="0.22em" rspace="0.22em"><mo>+</mo><mtext> ⁣</mtext><mo>+</mo></mo><mi>a</mi><mo>=</mo><mi>a</mi><mo>=</mo><mi>a</mi><mo lspace="0.22em" rspace="0.22em"><mo>+</mo><mtext> ⁣</mtext><mo>+</mo></mo><mi>ε</mi><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">bytes</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0.22em" rspace="0.22em"><mo>+</mo><mtext> ⁣</mtext><mo>+</mo></mo><mi>b</mi><mo stretchy="false">)</mo><mo>=</mo><mi mathvariant="normal">bytes</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo><mi mathvariant="normal">∥</mi><mi mathvariant="normal">bytes</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">(a &#92;mathbin{+&#92;!+} b) &#92;mathbin{+&#92;!+} c = a &#92;mathbin{+&#92;!+} (b &#92;mathbin{+&#92;!+} c),&#92;qquad &#92;varepsilon &#92;mathbin{+&#92;!+} a = a = a &#92;mathbin{+&#92;!+} &#92;varepsilon,&#92;qquad &#92;operatorname{bytes}(a &#92;mathbin{+&#92;!+} b) = &#92;operatorname{bytes}(a) &#92;Vert &#92;operatorname{bytes}(b).</annotation></semantics></math>
