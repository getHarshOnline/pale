<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mstyle scriptlevel="1"><mtable rowspacing="0.1em" columnalign="center" columnspacing="1em"><mtr><mtd><mstyle scriptlevel="1" displaystyle="false"><mrow><mi mathvariant="normal">Ret</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi mathvariant="normal">r</mi><mi mathvariant="normal">e</mi><mi mathvariant="normal">p</mi></mrow></msub><mo stretchy="false">)</mo><mo>⇒</mo><mi>r</mi><mo>&gt;</mo><mn>0</mn></mrow></mstyle></mtd></mtr><mtr><mtd><mstyle scriptlevel="1" displaystyle="false"><mrow><mi mathvariant="normal">Ret</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi mathvariant="normal">i</mi><mi mathvariant="normal">n</mi><mi mathvariant="normal">d</mi></mrow></msub><mo stretchy="false">)</mo><mo>⇒</mo><mo stretchy="false">(</mo><mo stretchy="false">(</mo><mi>ρ</mi><mo>=</mo><mrow><mi mathvariant="normal">i</mi><mi mathvariant="normal">n</mi><mi mathvariant="normal">d</mi><mi mathvariant="normal">e</mi><mi mathvariant="normal">p</mi><mi mathvariant="normal">e</mi><mi mathvariant="normal">n</mi><mi mathvariant="normal">d</mi><mi mathvariant="normal">e</mi><mi mathvariant="normal">n</mi><mi mathvariant="normal">t</mi></mrow><mo>⇒</mo><mi>p</mi><mo mathvariant="normal">≠</mo><mi>q</mi><mo stretchy="false">)</mo><mo>∧</mo><mo stretchy="false">(</mo><mi>ρ</mi><mo>=</mo><mrow><mi mathvariant="normal">c</mi><mi mathvariant="normal">o</mi><mi mathvariant="normal">u</mi><mi mathvariant="normal">p</mi><mi mathvariant="normal">l</mi><mi mathvariant="normal">e</mi><mi mathvariant="normal">d</mi></mrow><mo>⇒</mo><mi>K</mi><mo mathvariant="normal">≠</mo><mi mathvariant="normal">∅</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow></mstyle></mtd></mtr><mtr><mtd><mstyle scriptlevel="1" displaystyle="false"><mrow><mi mathvariant="normal">Ret</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi mathvariant="normal">g</mi><mi mathvariant="normal">r</mi><mi mathvariant="normal">d</mi></mrow></msub><mo stretchy="false">)</mo><mo>⇒</mo><mo stretchy="false">(</mo><mi>F</mi><mo mathvariant="normal">≠</mo><mi mathvariant="normal">∅</mi><mo>∧</mo><mi mathvariant="normal">refs</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo><mo>∪</mo><mi>X</mi><mo mathvariant="normal">≠</mo><mi mathvariant="normal">∅</mi><mo>∧</mo><mi mathvariant="normal">refs</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo><mo>∩</mo><mi>X</mi><mo>=</mo><mi mathvariant="normal">∅</mi><mo>∧</mo><mi mathvariant="normal">∣</mi><mi mathvariant="normal">refs</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo><mi mathvariant="normal">∣</mi><mo>=</mo><mi mathvariant="normal">∣</mi><mi>A</mi><mi mathvariant="normal">∣</mi><mo>∧</mo><mi mathvariant="normal">∀</mi><mi>i</mi><mo>&lt;</mo><mi mathvariant="normal">∣</mi><mi>A</mi><mi mathvariant="normal">∣</mi><mo>−</mo><mn>1</mn><mo separator="true">,</mo><mtext> </mtext><msub><mi>a</mi><mi>i</mi></msub><mo>&lt;</mo><msub><mi>a</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mstyle></mtd></mtr><mtr><mtd><mstyle scriptlevel="1" displaystyle="false"><mrow><mi mathvariant="normal">Ret</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi mathvariant="normal">c</mi><mi mathvariant="normal">o</mi><mi mathvariant="normal">v</mi></mrow></msub><mo stretchy="false">)</mo><mo>⇒</mo><mo stretchy="false">(</mo><mi>T</mi><mo mathvariant="normal">≠</mo><mi mathvariant="normal">∅</mi><mo>∧</mo><mi>T</mi><mo>=</mo><mi>O</mi><mo lspace="0.22em" rspace="0.22em"><mover accent="true"><mo>∪</mo><mo>˙</mo></mover></mo><mi mathvariant="normal">dom</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo><mo>∧</mo><mi mathvariant="normal">∣</mi><mi mathvariant="normal">dom</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo><mi mathvariant="normal">∣</mi><mo>=</mo><mi mathvariant="normal">∣</mi><mi>H</mi><mi mathvariant="normal">∣</mi><mo>∧</mo><mi>N</mi><mo>⊆</mo><mi>O</mi><mo>∧</mo><mi>E</mi><mo mathvariant="normal">≠</mo><mi mathvariant="normal">∅</mi><mo stretchy="false">)</mo></mrow></mstyle></mtd></mtr><mtr><mtd><mstyle scriptlevel="1" displaystyle="false"><mrow><mi mathvariant="normal">∀</mi><mi>Q</mi><mo>∈</mo><mi mathvariant="script">B</mi><mo separator="true">,</mo><mtext> </mtext><mi mathvariant="normal">∣</mi><mi>Q</mi><mi mathvariant="normal">∣</mi><mo>≤</mo><mn>4096.</mn></mrow></mstyle></mtd></mtr></mtable></mstyle></mrow><annotation encoding="application/x-tex">&#92;substack{&#92;operatorname{Ret}(s&#95;{&#92;mathrm{rep}}) &#92;Rightarrow r &gt; 0 &#92;&#92; &#92;operatorname{Ret}(s&#95;{&#92;mathrm{ind}}) &#92;Rightarrow ((&#92;rho = &#92;mathrm{independent} &#92;Rightarrow p &#92;ne q) &#92;land (&#92;rho = &#92;mathrm{coupled} &#92;Rightarrow K &#92;ne &#92;varnothing)) &#92;&#92; &#92;operatorname{Ret}(s&#95;{&#92;mathrm{grd}}) &#92;Rightarrow (F &#92;ne &#92;varnothing &#92;land &#92;operatorname{refs}(A) &#92;cup X &#92;ne &#92;varnothing &#92;land &#92;operatorname{refs}(A) &#92;cap X = &#92;varnothing &#92;land |&#92;operatorname{refs}(A)| = |A| &#92;land &#92;forall i &lt; |A| - 1,&#92; a&#95;i &lt; a&#95;{i+1}) &#92;&#92; &#92;operatorname{Ret}(s&#95;{&#92;mathrm{cov}}) &#92;Rightarrow (T &#92;ne &#92;varnothing &#92;land T = O &#92;mathbin{&#92;dot&#92;cup} &#92;operatorname{dom}(H) &#92;land |&#92;operatorname{dom}(H)| = |H| &#92;land N &#92;subseteq O &#92;land E &#92;ne &#92;varnothing) &#92;&#92; &#92;forall Q &#92;in &#92;mathcal{B},&#92; |Q| &#92;le 4096.}</annotation></semantics></math>
