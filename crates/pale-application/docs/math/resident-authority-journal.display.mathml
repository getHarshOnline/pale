<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><msub><mi>A</mi><mi>j</mi></msub><mo>=</mo><mo stretchy="false">(</mo><msub><mi>L</mi><mi>j</mi></msub><mo separator="true">,</mo><msub><mi>D</mi><mi>j</mi></msub><mo separator="true">,</mo><msub><mi>E</mi><mi>j</mi></msub><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><msub><mi>A</mi><mi>j</mi></msub><mover><mo stretchy="true" minsize="3.0em">→</mo><mpadded width="+0.6em" lspace="0.3em"><mrow><mi mathvariant="normal">d</mi><mi mathvariant="normal">e</mi><mi mathvariant="normal">r</mi><mi mathvariant="normal">i</mi><mi mathvariant="normal">v</mi><mi mathvariant="normal">e</mi></mrow></mpadded></mover><msub><mi>T</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo separator="true">,</mo><mspace width="2em"/><msub><mover accent="true"><mi>δ</mi><mo stretchy="true">^</mo></mover><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mi mathvariant="normal">prepare</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>P</mi><mi>j</mi></msub><mo separator="true">,</mo><msub><mi>T</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><mo stretchy="false">(</mo><msub><mi>A</mi><mi>j</mi></msub><mo separator="true">,</mo><msub><mi>P</mi><mi>j</mi></msub><mo separator="true">,</mo><msub><mi>R</mi><mi>j</mi></msub><mo separator="true">;</mo><msub><mover accent="true"><mi>δ</mi><mo stretchy="true">^</mo></mover><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mover><mo stretchy="true" minsize="3.0em">→</mo><mpadded width="+0.6em" lspace="0.3em"><mrow><mrow><mi mathvariant="normal">a</mi><mi mathvariant="normal">p</mi><mi mathvariant="normal">p</mi><mi mathvariant="normal">e</mi><mi mathvariant="normal">n</mi><mi mathvariant="normal">d</mi></mrow><mo stretchy="false">(</mo><mi>j</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mpadded></mover><mo stretchy="false">(</mo><msub><mi>A</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo separator="true">,</mo><msub><mi>P</mi><mi>j</mi></msub><mo separator="true">,</mo><msub><mi>R</mi><mi>j</mi></msub><mo separator="true">;</mo><msub><mover accent="true"><mi>δ</mi><mo stretchy="true">^</mo></mover><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mover><mo stretchy="true" minsize="3.0em">→</mo><mpadded width="+0.6em" lspace="0.3em"><mrow><mi mathvariant="normal">a</mi><mi mathvariant="normal">p</mi><mi mathvariant="normal">p</mi><mi mathvariant="normal">l</mi><mi mathvariant="normal">y</mi></mrow></mpadded></mover><mo stretchy="false">(</mo><msub><mi>A</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo separator="true">,</mo><msub><mi>P</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo separator="true">,</mo><msub><mi>R</mi><mi>j</mi></msub><mo stretchy="false">)</mo><mover><mo stretchy="true" minsize="3.0em">→</mo><mpadded width="+0.6em" lspace="0.3em"><mrow><mrow><mi mathvariant="normal">p</mi><mi mathvariant="normal">u</mi><mi mathvariant="normal">b</mi><mi mathvariant="normal">l</mi><mi mathvariant="normal">i</mi><mi mathvariant="normal">s</mi><mi mathvariant="normal">h</mi></mrow><mo stretchy="false">(</mo><mi>j</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mpadded></mover><mo stretchy="false">(</mo><msub><mi>A</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo separator="true">,</mo><msub><mi>P</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo separator="true">,</mo><msub><mi>R</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><msub><mi>P</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mi>π</mi><mo stretchy="false">(</mo><msub><mi>A</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">predecessor</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>e</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo>=</mo><mi>h</mi><mo stretchy="false">(</mo><msub><mi>A</mi><mi>i</mi></msub><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><msub><mi>A</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mi mathvariant="normal">apply</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>A</mi><mi>i</mi></msub><mo separator="true">,</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">successor</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>e</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo>=</mo><mi>h</mi><mo stretchy="false">(</mo><msub><mi>A</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><mi>h</mi><mtext> ⁣</mtext><mrow><mo fence="true">(</mo><mi mathvariant="normal">admit</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>C</mi><mi>k</mi></msub><mo stretchy="false">)</mo><mo fence="true">)</mo></mrow><mo>=</mo><mi mathvariant="normal">successor</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>e</mi><mi>k</mi></msub><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><msub><mi>A</mi><mi>n</mi></msub><mo>=</mo><mi mathvariant="normal">fold</mi><mo>⁡</mo><mtext> ⁣</mtext><mrow><mo fence="true">(</mo><mi mathvariant="normal">admit</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>C</mi><mi>k</mi></msub><mo stretchy="false">)</mo><mo separator="true">,</mo><mo stretchy="false">&#91;</mo><msub><mi>e</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo separator="true">,</mo><mo>…</mo><mo separator="true">,</mo><msub><mi>e</mi><mi>n</mi></msub><mo stretchy="false">&#93;</mo><mo fence="true">)</mo></mrow><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">A&#95;j=(L&#95;j,D&#95;j,E&#95;j),&#92;qquad A&#95;j&#92;xrightarrow{&#92;mathrm{derive}}T&#95;{j+1},&#92;qquad &#92;widehat{&#92;delta}&#95;{j+1}=&#92;operatorname{prepare}(P&#95;j,T&#95;{j+1}),&#92;qquad (A&#95;j,P&#95;j,R&#95;j;&#92;widehat{&#92;delta}&#95;{j+1})&#92;xrightarrow{&#92;mathrm{append}(j+1)}(A&#95;{j+1},P&#95;j,R&#95;j;&#92;widehat{&#92;delta}&#95;{j+1})&#92;xrightarrow{&#92;mathrm{apply}}(A&#95;{j+1},P&#95;{j+1},R&#95;j)&#92;xrightarrow{&#92;mathrm{publish}(j+1)}(A&#95;{j+1},P&#95;{j+1},R&#95;{j+1}),&#92;qquad P&#95;{j+1}=&#92;pi(A&#95;{j+1}),&#92;qquad &#92;operatorname{predecessor}(e&#95;{i+1})=h(A&#95;i),&#92;qquad A&#95;{i+1}=&#92;operatorname{apply}(A&#95;i,&#92;Delta&#95;{i+1}),&#92;qquad &#92;operatorname{successor}(e&#95;{i+1})=h(A&#95;{i+1}),&#92;qquad h&#92;!&#92;left(&#92;operatorname{admit}(C&#95;k)&#92;right)=&#92;operatorname{successor}(e&#95;k),&#92;qquad A&#95;n=&#92;operatorname{fold}&#92;!&#92;left(&#92;operatorname{admit}(C&#95;k),&#91;e&#95;{k+1},&#92;ldots,e&#95;n&#93;&#92;right).</annotation></semantics></math>
