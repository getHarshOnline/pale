/mrow><mo>=</mo><mi>a</mi><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">&#92;mathcal{R}&#95;{&#92;mathrm{observation}}=&#92;{&#92;mathrm{ready},&#92;mathrm{unproven},&#92;mathrm{unavailable},&#92;mathrm{narrowed},&#92;mathrm{blocked}&#92;},&#92;qquad &#92;mathrm{ready}&#92;succeq&#92;mathrm{unproven}&#92;succeq&#92;mathrm{unavailable}&#92;succeq&#92;mathrm{narrowed}&#92;succeq&#92;mathrm{blocked};&#92;qquad a&#92;wedge b=b&#92;wedge a,&#92;quad (a&#92;wedge b)&#92;wedge c=a&#92;wedge(b&#92;wedge c),&#92;quad a&#92;wedge a=a,&#92;quad a&#92;wedge&#92;mathrm{ready}=a.</annotation></semantics></math>
