<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><msub><mi>E</mi><mrow><mi>g</mi><mo separator="true">,</mo><mi>r</mi><mo separator="true">,</mo><mi>χ</mi></mrow></msub><mo>=</mo><mi>C</mi><mtext> ⁣</mtext><mrow><mo fence="true">(</mo><msub><mi>I</mi><mrow><mi>g</mi><mo separator="true">,</mo><mi>r</mi><mo separator="true">,</mo><mi>χ</mi></mrow></msub><mo fence="true">)</mo></mrow><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">shown</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>g</mi><mo separator="true">,</mo><mi>r</mi><mo separator="true">,</mo><mi>χ</mi><mo stretchy="false">)</mo><mo>∈</mo><mrow><mo fence="true">{</mo><msub><mi>E</mi><mrow><mi>g</mi><mo separator="true">,</mo><mi>r</mi><mo separator="true">,</mo><mi>χ</mi></mrow></msub><mo separator="true">,</mo><mtext>  </mtext><mi mathvariant="normal">stale</mi><mo>⁡</mo><mtext> ⁣</mtext><mrow><mo fence="true">(</mo><msub><mi>E</mi><mrow><msub><mi>g</mi><mi>a</mi></msub><mo separator="true">,</mo><msub><mi>r</mi><mi>a</mi></msub><mo separator="true">,</mo><mi>χ</mi></mrow></msub><mo fence="true">)</mo></mrow><mo separator="true">,</mo><mtext>  </mtext><mi mathvariant="normal">∅</mi><mo fence="true">}</mo></mrow><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">E&#95;{g,r,&#92;chi}=C&#92;!&#92;left(I&#95;{g,r,&#92;chi}&#92;right),&#92;qquad &#92;operatorname{shown}(g,r,&#92;chi)&#92;in&#92;left&#92;{E&#95;{g,r,&#92;chi},&#92;;&#92;operatorname{stale}&#92;!&#92;left(E&#95;{g&#95;a,r&#95;a,&#92;chi}&#92;right),&#92;;&#92;varnothing&#92;right&#92;}.</annotation></semantics></math>
