{
  "$defs": {
    "ModeAxis": {
      "oneOf": [
        {
          "const": "intensity",
          "type": "string"
        },
        {
          "const": "task_stance",
          "type": "string"
        }
      ]
    },
    "ModeScope": {
      "oneOf": [
        {
          "const": "runtime",
          "type": "string"
        },
        {
          "const": "session_only",
          "type": "string"
        }
      ]
    },
    "OwnedConfinedRelativePath": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "PackageIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "PackageResourceIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:[./][a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "PackageResourceLinkV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "resource_id": {
              "$ref": "#/$defs/PackageResourceIdV1"
            },
            "scope": {
              "const": "local",
              "type": "string"
            }
          },
          "required": [
            "scope",
            "resource_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "resource": {
              "$ref": "#/$defs/PackageResourceRefV1"
            },
            "scope": {
              "const": "external",
              "type": "string"
            }
          },
          "required": [
            "scope",
            "resource"
          ],
          "type": "object"
        }
      ]
    },
    "PackageResourceRefV1": {
      "additionalProperties": false,
      "properties": {
        "package_id": {
          "$ref": "#/$defs/PackageIdV1"
        },
        "resource_id": {
          "$ref": "#/$defs/PackageResourceIdV1"
        }
      },
      "required": [
        "package_id",
        "resource_id"
      ],
      "type": "object"
    },
    "RunMode": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "axis": {
          "$ref": "#/$defs/ModeAxis"
        },
        "description": {
          "type": "string"
        },
        "doctrine": {
          "anyOf": [
            {
              "$ref": "#/$defs/OwnedConfinedRelativePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "exact_triggers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "extends": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PackageResourceLinkV1"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/PackageResourceIdV1"
        },
        "scope": {
          "$ref": "#/$defs/ModeScope"
        }
      },
      "required": [
        "id",
        "description",
        "axis",
        "scope"
      ],
      "type": "object"
    },
    "RunModeCatalog": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "items": {
            "$ref": "#/$defs/RunMode"
          },
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "mode"
      ],
      "type": "object"
    }
  },
  "$id": "https://www.rawthoughts.in/pale/schemas/run-mode.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "run_modes": {
      "$ref": "#/$defs/RunModeCatalog"
    }
  },
  "required": [
    "run_modes"
  ],
  "title": "run-mode.v1",
  "type": "object"
}
