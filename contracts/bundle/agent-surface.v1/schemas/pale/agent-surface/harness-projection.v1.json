{
  "$defs": {
    "LogicalRepositoryIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:[.:/][a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "ManagedFrontDoorDigest": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "managed_block_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        },
        "ownership": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/surface-ownership.v1.json"
        },
        "rel_path": {
          "type": "string"
        }
      },
      "required": [
        "rel_path",
        "kind",
        "ownership",
        "managed_block_sha256"
      ],
      "type": "object"
    },
    "ProviderBindingIdentityV1": {
      "additionalProperties": false,
      "properties": {
        "provider_binding_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        }
      },
      "required": [
        "provider_binding_sha256"
      ],
      "type": "object"
    },
    "ProviderBindingRefV1": {
      "additionalProperties": false,
      "properties": {
        "provider_binding_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._/-]+$",
          "type": "string"
        },
        "provider_binding_identity": {
          "$ref": "#/$defs/ProviderBindingIdentityV1"
        }
      },
      "required": [
        "provider_binding_id",
        "provider_binding_identity"
      ],
      "type": "object"
    }
  },
  "$id": "https://www.rawthoughts.in/pale/schemas/harness-projection.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "https://www.rawthoughts.in/pale/schemas/surface-digest.v1.json"
      },
      "type": "array"
    },
    "front_door": {
      "$ref": "#/$defs/ManagedFrontDoorDigest"
    },
    "instance_digest": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "profile_digest": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "provider_binding": {
      "$ref": "#/$defs/ProviderBindingRefV1"
    },
    "repository_id": {
      "$ref": "#/$defs/LogicalRepositoryIdV1"
    },
    "schema": {
      "const": "pale.agent-surface.harness-projection.v1",
      "type": "string"
    },
    "schema_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "schema_version": {
      "const": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "schema_sha256",
    "schema_version",
    "repository_id",
    "provider_binding",
    "profile_digest",
    "instance_digest",
    "front_door",
    "artifacts"
  ],
  "title": "harness-projection.v1",
  "type": "object"
}
