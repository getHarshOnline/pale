{
  "name": "@rtepl/pale",
  "version": "0.0.1",
  "private": true,
  "author": "Harsh Joshi",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getHarshOnline/pale.git",
    "directory": "sdk/js"
  },
  "description": "PaleJS, the native JavaScript/TypeScript SDK for Node.js.",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "bench:smoke": "node benches/native_ffi.mjs ./index.js ./tests/fixtures/cross-leaf.v1 --smoke",
    "test:abi": "node --expose-gc tests/native_abi.mjs ./index.js ./tests/fixtures/cross-leaf.v1",
    "test:declarations": "node tests/declarations.mjs",
    "test:package": "node tests/package_consumer.mjs",
    "test": "npm run build && npm run test:declarations && npm run test:abi && npm run test:package"
  },
  "dependencies": {
    "@types/node": "22.19.20"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.9.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "napi": {
    "binaryName": "pale-js-native",
    "dtsHeader": "/* auto-generated by NAPI-RS */\n/* eslint-disable */\n/// <reference types=\"node\" />\nimport type { Buffer } from 'node:buffer';\n"
  }
}
