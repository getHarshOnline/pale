<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><msub><mi>O</mi><mi>n</mi></msub><mo>⇝</mo><msub><mi>O</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mtext>  </mtext><mo>⟺</mo><mtext>  </mtext><msub><mi>r</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><msub><mi>r</mi><mi>n</mi></msub><mo>+</mo><mn>1</mn><mtext>  </mtext><mo>∧</mo><mtext>  </mtext><mi mathvariant="normal">pred</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>O</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo>=</mo><mi mathvariant="normal">coord</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>O</mi><mi>n</mi></msub><mo stretchy="false">)</mo><mtext>  </mtext><mo>∧</mo><mtext>  </mtext><msub><mi>t</mi><mi>n</mi></msub><mo>≤</mo><msub><mi>t</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mtext>  </mtext><mo>∧</mo><mtext>  </mtext><msub><mi>s</mi><mi>n</mi></msub><mo>⊑</mo><msub><mi>s</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">terminal</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>s</mi><mi>n</mi></msub><mo stretchy="false">)</mo><mo>⟹</mo><mi mathvariant="normal">∄</mi><msub><mi>O</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">O&#95;n &#92;rightsquigarrow O&#95;{n+1}&#92;iff r&#95;{n+1}=r&#95;n+1&#92;;&#92;land&#92;;&#92;operatorname{pred}(O&#95;{n+1})=&#92;operatorname{coord}(O&#95;n)&#92;;&#92;land&#92;;t&#95;n&#92;leq t&#95;{n+1}&#92;;&#92;land&#92;;s&#95;n&#92;sqsubseteq s&#95;{n+1},&#92;qquad &#92;operatorname{terminal}(s&#95;n)&#92;Longrightarrow&#92;nexists O&#95;{n+1}.</annotation></semantics></math>
