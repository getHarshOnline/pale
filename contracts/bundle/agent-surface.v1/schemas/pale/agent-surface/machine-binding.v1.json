{
  "$defs": {
    "DurableEvidenceBinding": {
      "additionalProperties": false,
      "properties": {
        "retention_seconds": {
          "$ref": "#/$defs/EvidenceRetentionSeconds"
        },
        "root": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "root",
        "retention_seconds"
      ],
      "type": "object"
    },
    "EvidenceRetentionSeconds": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "LogicalRepositoryIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:[.:/][a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "MachineMeta": {
      "additionalProperties": false,
      "properties": {
        "distribution_root": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "schema_version"
      ],
      "type": "object"
    },
    "MaterializationLineageBinding": {
      "additionalProperties": false,
      "properties": {
        "max_route_records_per_collection": {
          "$ref": "#/$defs/RouteRecordLimit"
        },
        "root": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "root",
        "max_route_records_per_collection"
      ],
      "type": "object"
    },
    "PackageIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "PackageResourceIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:[./][a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "PackageResourceRefV1": {
      "additionalProperties": false,
      "properties": {
        "package_id": {
          "$ref": "#/$defs/PackageIdV1"
        },
        "resource_id": {
          "$ref": "#/$defs/PackageResourceIdV1"
        }
      },
      "required": [
        "package_id",
        "resource_id"
      ],
      "type": "object"
    },
    "ProviderRepositoryProjectionV1": {
      "additionalProperties": false,
      "properties": {
        "native_repository_coordinate": {
          "minLength": 1,
          "type": "string"
        },
        "provider_binding_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._/-]+$",
          "type": "string"
        },
        "repository_id": {
          "$ref": "#/$defs/LogicalRepositoryIdV1"
        }
      },
      "required": [
        "repository_id",
        "provider_binding_id",
        "native_repository_coordinate"
      ],
      "type": "object"
    },
    "RepositoryCheckoutBindingV1": {
      "additionalProperties": false,
      "properties": {
        "checkout_root": {
          "minLength": 1,
          "type": "string"
        },
        "git_metadata_root": {
          "minLength": 1,
          "type": "string"
        },
        "repository_id": {
          "$ref": "#/$defs/LogicalRepositoryIdV1"
        }
      },
      "required": [
        "repository_id",
        "checkout_root"
      ],
      "type": "object"
    },
    "RouteRecordLimit": {
      "format": "uint32",
      "maximum": 65536,
      "minimum": 1,
      "type": "integer"
    },
    "SessionStateBinding": {
      "additionalProperties": false,
      "properties": {
        "root": {
          "minLength": 1,
          "type": "string"
        },
        "ttl_seconds": {
          "$ref": "#/$defs/SessionTtlSeconds"
        }
      },
      "required": [
        "root",
        "ttl_seconds"
      ],
      "type": "object"
    },
    "SessionTtlSeconds": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "UserPreferences": {
      "additionalProperties": false,
      "properties": {
        "mode_defaults": {
          "additionalProperties": {
            "$ref": "#/$defs/PackageResourceRefV1"
          },
          "default": {},
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://www.rawthoughts.in/pale/schemas/machine-binding.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_roots": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "durable_evidence": {
      "$ref": "#/$defs/DurableEvidenceBinding"
    },
    "machine": {
      "$ref": "#/$defs/MachineMeta"
    },
    "materialization_lineage": {
      "$ref": "#/$defs/MaterializationLineageBinding"
    },
    "native_harnesses": {
      "items": {
        "$ref": "https://www.rawthoughts.in/pale/schemas/native-harness-binding.v1.json"
      },
      "type": "array",
      "uniqueItems": true
    },
    "preferences": {
      "$ref": "#/$defs/UserPreferences"
    },
    "provider_repositories": {
      "items": {
        "$ref": "#/$defs/ProviderRepositoryProjectionV1"
      },
      "type": "array",
      "uniqueItems": true
    },
    "repository_checkouts": {
      "items": {
        "$ref": "#/$defs/RepositoryCheckoutBindingV1"
      },
      "type": "array",
      "uniqueItems": true
    },
    "session_state": {
      "$ref": "#/$defs/SessionStateBinding"
    },
    "surface_executable": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/surface-executable-binding.v1.json"
    }
  },
  "required": [
    "machine",
    "authority_roots"
  ],
  "title": "machine-binding.v1",
  "type": "object"
}
