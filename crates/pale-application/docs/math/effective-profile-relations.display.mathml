ormal">o</mi><mi mathvariant="normal">w</mi><mi mathvariant="normal">n</mi></mrow><mtext> ⁣</mtext><mrow><mo fence="true">(</mo><msub><mi>M</mi><mi>m</mi></msub><mo stretchy="false">(</mo><mi>E</mi><mo stretchy="false">)</mo><mo fence="true">)</mo></mrow><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">E=C(I),&#92;qquad &#92;mathrm{Satisfied}=&#92;mathrm{Required}(I)&#92;cap&#92;mathrm{Available}(E),&#92;quad &#92;mathrm{Missing}=&#92;mathrm{Required}(I)&#92;setminus&#92;mathrm{Available}(E),&#92;quad &#92;mathrm{Blocked}=&#92;mathrm{Required}(I)&#92;cap&#92;mathrm{Forbidden}(E),&#92;quad &#92;mathrm{Unproven}&#95;{m}=&#92;mathrm{Required}(I)&#92;cap&#92;mathrm{Unknown}&#92;!&#92;left(M&#95;m(E)&#92;right).</annotation></semantics></math>
