      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "relationship_scope": {
      "$ref": "#/$defs/RelationshipScopeV1"
    },
    "request_id": {
      "$ref": "#/$defs/ResidentRequestIdV1"
    },
    "schema_id": {
      "$ref": "#/$defs/SchemaId",
      "const": "pale/effect-conflict-claim.v1"
    },
    "schema_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "signature": {
      "$ref": "#/$defs/CanonicalSignatureV1"
