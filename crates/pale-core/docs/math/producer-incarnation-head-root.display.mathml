<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi mathvariant="normal">root</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo><mo>=</mo><mi mathvariant="normal">SHA-256</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi mathvariant="normal">JCS</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi mathvariant="normal">array</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>h</mi><mn>1</mn></msub><mo separator="true">,</mo><mo>…</mo><mo separator="true">,</mo><msub><mi>h</mi><mi>n</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">key</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>h</mi><mi>i</mi></msub><mo stretchy="false">)</mo><mo>&lt;</mo><mi mathvariant="normal">key</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>h</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">∅</mi><mo>⟶</mo><mi mathvariant="normal">active</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo><mo>⟶</mo><mi mathvariant="normal">retired</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">retired</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo><mo>⟶</mo><mi mathvariant="normal">active</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><mi>β</mi><mo mathvariant="normal">∉</mo><mi>E</mi><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">&#92;operatorname{root}(H)=&#92;operatorname{SHA&#92;text{-}256}(&#92;operatorname{JCS}(&#92;operatorname{array}(h&#95;1,&#92;ldots,h&#95;n))),&#92;qquad &#92;operatorname{key}(h&#95;i)&lt;&#92;operatorname{key}(h&#95;{i+1}),&#92;qquad &#92;varnothing&#92;longrightarrow&#92;operatorname{active}(&#92;alpha)&#92;longrightarrow&#92;operatorname{retired}(&#92;alpha),&#92;qquad &#92;operatorname{retired}(&#92;alpha)&#92;longrightarrow&#92;operatorname{active}(&#92;beta),&#92;qquad &#92;beta&#92;notin E.</annotation></semantics></math>
