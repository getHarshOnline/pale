<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi>X</mi><mo>⪯</mo><mi>P</mi><mtext>  </mtext><mo>⟺</mo><mtext>  </mtext><munder><mo>⋀</mo><mrow><mi>a</mi><mo>∈</mo><mo stretchy="false">{</mo><mi>O</mi><mo separator="true">,</mo><mi>Q</mi><mo separator="true">,</mo><mi>C</mi><mo separator="true">,</mo><mi>E</mi><mo separator="true">,</mo><mi>V</mi><mo separator="true">,</mo><mi>R</mi><mo separator="true">,</mo><mi>A</mi><mo separator="true">,</mo><mi>D</mi><mo separator="true">,</mo><mi>M</mi><mo separator="true">,</mo><mi>G</mi><mo separator="true">,</mo><mi>F</mi><mo stretchy="false">}</mo></mrow></munder><msub><mi>X</mi><mi>a</mi></msub><mo>⊆</mo><msub><mi>P</mi><mi>a</mi></msub><mtext> </mtext><mo>∧</mo><mtext> </mtext><mi mathvariant="normal">∀</mi><mi>b</mi><mo>∈</mo><mi mathvariant="normal">dom</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>X</mi><mi>B</mi></msub><mo stretchy="false">)</mo><mo>:</mo><mi>b</mi><mo>∈</mo><mi mathvariant="normal">dom</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>P</mi><mi>B</mi></msub><mo stretchy="false">)</mo><mo>∧</mo><msub><mi>X</mi><mi>B</mi></msub><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo><mo>≤</mo><msub><mi>P</mi><mi>B</mi></msub><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">X&#92;preceq P&#92;iff&#92;bigwedge&#95;{a&#92;in&#92;{O,Q,C,E,V,R,A,D,M,G,F&#92;}}X&#95;a&#92;subseteq P&#95;a&#92; &#92;land&#92; &#92;forall b&#92;in&#92;operatorname{dom}(X&#95;B):b&#92;in&#92;operatorname{dom}(P&#95;B)&#92;land X&#95;B(b)&#92;le P&#95;B(b).</annotation></semantics></math>
