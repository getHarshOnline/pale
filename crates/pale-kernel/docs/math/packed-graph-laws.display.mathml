"normal">o</mi><mi mathvariant="normal">o</mi><mi mathvariant="normal">k</mi><mi mathvariant="normal">u</mi><mi mathvariant="normal">p</mi></mrow></msub><mo>∈</mo><mi>O</mi><mo stretchy="false">(</mo><mi>log</mi><mo>⁡</mo><mi mathvariant="normal">∣</mi><mi>V</mi><mi mathvariant="normal">∣</mi><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><msub><mi>T</mi><mrow><mi mathvariant="normal">n</mi><mi mathvariant="normal">e</mi><mi mathvariant="normal">i</mi><mi mathvariant="normal">g</mi><mi mathvariant="normal">h</mi><mi mathvariant="normal">b</mi><mi mathvariant="normal">o</mi><mi mathvariant="normal">r</mi><mi mathvariant="normal">s</mi></mrow></msub><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo><mo>∈</mo><mi>O</mi><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><msub><mi>M</mi><mrow><mi mathvariant="normal">p</mi><mi mathvariant="normal">r</mi><mi mathvariant="normal">o</mi><mi mathvariant="normal">o</mi><mi mathvariant="normal">f</mi></mrow></msub><mo>∈</mo><mi>O</mi><mo stretchy="false">(</mo><mi mathvariant="normal">∣</mi><mi>V</mi><mi mathvariant="normal">∣</mi><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><msub><mi>T</mi><mrow><mi mathvariant="normal">p</mi><mi mathvariant="normal">a</mi><mi mathvariant="normal">t</mi><mi mathvariant="normal">h</mi></mrow></msub><mo>∈</mo><mi>O</mi><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">&#92;iota&#95;V:K&#92;leftrightarrow&#92;{0,&#92;ldots,|V|-1&#92;},&#92;qquad &#92;iota&#95;E:I&#92;leftrightarrow&#92;{0,&#92;ldots,|E|-1&#92;},&#92;qquad T&#95;{&#92;mathrm{build}}&#92;in O((|V|+|E|)&#92;log(|V|+|E|)),&#92;qquad T&#95;{&#92;mathrm{walk}}&#92;in O(|V|+|E|),&#92;qquad T&#95;{&#92;mathrm{lookup}}&#92;in O(&#92;log|V|),&#92;qquad T&#95;{&#92;mathrm{neighbors}}(v)&#92;in O(d(v)),&#92;qquad M&#95;{&#92;mathrm{proof}}&#92;in O(|V|),&#92;qquad T&#95;{&#92;mathrm{path}}&#92;in O(&#92;ell).</annotation></semantics></math>
