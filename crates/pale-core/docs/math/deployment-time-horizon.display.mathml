<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi mathvariant="normal">proposed</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>P</mi><mo stretchy="false">)</mo><mo>≤</mo><mi mathvariant="normal">accepted</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo><mo>≤</mo><mi mathvariant="normal">proposalExpires</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>P</mi><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">issued</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo><mo>≥</mo><mi mathvariant="normal">accepted</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">expires</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo><mo>≤</mo><mi mathvariant="normal">bindingValidUntil</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">&#92;operatorname{proposed}(P)&#92;le&#92;operatorname{accepted}(A)&#92;le&#92;operatorname{proposalExpires}(P),&#92;qquad&#92;operatorname{issued}(B)&#92;ge&#92;operatorname{accepted}(A),&#92;qquad&#92;operatorname{expires}(B)&#92;le&#92;operatorname{bindingValidUntil}(A).</annotation></semantics></math>
