{
  "$defs": {
    "TerminationKindV1": {
      "oneOf": [
        {
          "const": "completed",
          "type": "string"
        },
        {
          "const": "cancelled",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "expired",
          "type": "string"
        },
        {
          "const": "effect_unknown",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://www.rawthoughts.in/pale/schemas/termination-contract.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+$",
      "type": "string"
    },
    "kinds": {
      "items": {
        "$ref": "#/$defs/TerminationKindV1"
      },
      "maxItems": 5,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "owner": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/composition-primitives.v1.json#/$defs/ParticipantRefV1"
    },
    "terminal_leaf": {
      "anyOf": [
        {
          "$ref": "https://www.rawthoughts.in/pale/schemas/composition-primitives.v1.json#/$defs/ParticipantRefV1"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "owner",
    "kinds",
    "terminal_leaf"
  ],
  "title": "termination-contract.v1",
  "type": "object"
}
