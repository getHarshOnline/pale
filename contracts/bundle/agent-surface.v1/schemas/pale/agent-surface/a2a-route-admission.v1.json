{
  "$defs": {
    "A2aHttpsEndpointV1": {
      "maxLength": 512,
      "minLength": 9,
      "pattern": "^https://[^\\s]+$",
      "type": "string"
    },
    "A2aProtocolVersionV1": {
      "oneOf": [
        {
          "const": "1.0",
          "type": "string"
        }
      ]
    },
    "A2aRequestBindingV1": {
      "oneOf": [
        {
          "const": "json_rpc2_over_verified_https",
          "type": "string"
        }
      ]
    },
    "A2aRouteAdmissionIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "A2aSecurityAdmissionV1": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "$ref": "#/$defs/ImmutableRecordReferenceV1"
        },
        "selected_scheme_ids": {
          "items": {
            "$ref": "#/$defs/A2aSecuritySchemeIdV1"
          },
          "type": "array"
        }
      },
      "required": [
        "selected_scheme_ids",
        "evidence"
      ],
      "type": "object"
    },
    "A2aSecuritySchemeIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "A2aStreamingAdmissionV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "not_advertised",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence": {
              "$ref": "#/$defs/ImmutableRecordReferenceV1"
            },
            "state": {
              "const": "advertised",
              "type": "string"
            }
          },
          "required": [
            "state",
            "evidence"
          ],
          "type": "object"
        }
      ]
    },
    "BoundedResidentTextV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "CanonicalSignatureV1": {
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$",
      "type": "string"
    },
    "CommonRequestRouteV1": {
      "additionalProperties": false,
      "properties": {
        "contract_set_ref": {
          "$ref": "#/$defs/ResidentRecordRefV1"
        },
        "contract_set_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        },
        "destination_node_id": {
          "$ref": "#/$defs/ResidentNodeIdV1"
        },
        "destination_principal_id": {
          "$ref": "#/$defs/ResidentPrincipalIdV1"
        },
        "origin_node_id": {
          "$ref": "#/$defs/ResidentNodeIdV1"
        },
        "origin_principal_id": {
          "$ref": "#/$defs/ResidentPrincipalIdV1"
        },
        "route_binding_ref": {
          "$ref": "#/$defs/ResidentRecordRefV1"
        },
        "route_binding_schema_id": {
          "$ref": "#/$defs/SchemaId"
        },
        "route_binding_schema_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        },
        "route_binding_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        },
        "route_generation": {
          "$ref": "#/$defs/RouteGenerationV1"
        },
        "route_id": {
          "$ref": "#/$defs/ResidentRouteIdV1"
        },
        "transport": {
          "$ref": "#/$defs/BoundedResidentTextV1"
        }
      },
      "required": [
        "origin_principal_id",
        "origin_node_id",
        "destination_principal_id",
        "route_id",
        "route_generation",
        "transport",
        "route_binding_schema_id",
        "route_binding_schema_sha256",
        "route_binding_ref",
        "route_binding_sha256",
        "contract_set_ref",
        "contract_set_sha256"
      ],
      "type": "object"
    },
    "ImmutableRecordReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "record_ref": {
          "$ref": "#/$defs/ResidentRecordRefV1"
        },
        "record_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        }
      },
      "required": [
        "record_ref",
        "record_sha256"
      ],
      "type": "object"
    },
    "ProviderBindingIdentityV1": {
      "additionalProperties": false,
      "properties": {
        "provider_binding_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        }
      },
      "required": [
        "provider_binding_sha256"
      ],
      "type": "object"
    },
    "ProviderBindingRefV1": {
      "additionalProperties": false,
      "properties": {
        "provider_binding_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._/-]+$",
          "type": "string"
        },
        "provider_binding_identity": {
          "$ref": "#/$defs/ProviderBindingIdentityV1"
        }
      },
      "required": [
        "provider_binding_id",
        "provider_binding_identity"
      ],
      "type": "object"
    },
    "ResidentKeyIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentNodeIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentPrincipalIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentRecordRefV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentRouteIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "RouteGenerationV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "SchemaId": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$",
      "type": "string"
    },
    "SigningKeyEpochV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "UnixTimeV1": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "$id": "https://www.rawthoughts.in/pale/schemas/a2a-route-admission.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_card": {
      "$ref": "#/$defs/ImmutableRecordReferenceV1"
    },
    "canonical_a2a_route_admission_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "deployment_runtime_authority_ref": {
      "$ref": "#/$defs/ResidentRecordRefV1"
    },
    "deployment_runtime_authority_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "endpoint": {
      "$ref": "#/$defs/A2aHttpsEndpointV1"
    },
    "expires_at": {
      "$ref": "#/$defs/UnixTimeV1"
    },
    "fresh_until": {
      "$ref": "#/$defs/UnixTimeV1"
    },
    "issuer_key_epoch": {
      "$ref": "#/$defs/SigningKeyEpochV1"
    },
    "issuer_key_id": {
      "$ref": "#/$defs/ResidentKeyIdV1"
    },
    "issuer_principal_id": {
      "$ref": "#/$defs/ResidentPrincipalIdV1"
    },
    "observed_at": {
      "$ref": "#/$defs/UnixTimeV1"
    },
    "protocol_version": {
      "$ref": "#/$defs/A2aProtocolVersionV1"
    },
    "provider_binding": {
      "$ref": "#/$defs/ProviderBindingRefV1"
    },
    "request_binding": {
      "$ref": "#/$defs/A2aRequestBindingV1"
    },
    "route": {
      "$ref": "#/$defs/CommonRequestRouteV1"
    },
    "route_admission_id": {
      "$ref": "#/$defs/A2aRouteAdmissionIdV1"
    },
    "schema_id": {
      "$ref": "#/$defs/SchemaId",
      "const": "pale/a2a-route-admission.v1"
    },
    "schema_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "security": {
      "$ref": "#/$defs/A2aSecurityAdmissionV1"
    },
    "signature": {
      "$ref": "#/$defs/CanonicalSignatureV1"
    },
    "streaming": {
      "$ref": "#/$defs/A2aStreamingAdmissionV1"
    }
  },
  "required": [
    "schema_id",
    "schema_sha256",
    "route_admission_id",
    "provider_binding",
    "route",
    "endpoint",
    "protocol_version",
    "request_binding",
    "agent_card",
    "streaming",
    "security",
    "observed_at",
    "fresh_until",
    "expires_at",
    "deployment_runtime_authority_ref",
    "deployment_runtime_authority_sha256",
    "issuer_principal_id",
    "issuer_key_id",
    "issuer_key_epoch",
    "canonical_a2a_route_admission_sha256",
    "signature"
  ],
  "title": "a2a-route-admission.v1",
  "type": "object"
}
