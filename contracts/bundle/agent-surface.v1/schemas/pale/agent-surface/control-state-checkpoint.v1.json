{
  "$defs": {
    "CanonicalSignatureV1": {
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$",
      "type": "string"
    },
    "ChangedControlLeafKeyV1": {
      "additionalProperties": false,
      "properties": {
        "logical_key": {
          "$ref": "#/$defs/ControlLogicalKeyV1"
        },
        "record_class": {
          "$ref": "#/$defs/ControlRecordClassV1"
        },
        "scope_key_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        }
      },
      "required": [
        "record_class",
        "scope_key_sha256",
        "logical_key"
      ],
      "type": "object"
    },
    "ControlCheckpointDomainIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ControlCheckpointIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ControlDomainEpochV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "ControlDomainSequenceV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "ControlIncarnationIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ControlLeafCountV1": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "ControlLogicalKeyV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ControlRecordClassV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ControlStoreIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ControlTransactionSequenceV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "ResidentKeyIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentPrincipalIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentRecordRefV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "SchemaId": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$",
      "type": "string"
    },
    "SigningKeyEpochV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "UnixTimeV1": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "$id": "https://www.rawthoughts.in/pale/schemas/control-state-checkpoint.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_control_checkpoint_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "changed_leaf_keys": {
      "items": {
        "$ref": "#/$defs/ChangedControlLeafKeyV1"
      },
      "type": "array"
    },
    "checkpoint_domain_id": {
      "$ref": "#/$defs/ControlCheckpointDomainIdV1"
    },
    "checkpoint_profile_ref": {
      "$ref": "#/$defs/ResidentRecordRefV1"
    },
    "checkpoint_profile_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
