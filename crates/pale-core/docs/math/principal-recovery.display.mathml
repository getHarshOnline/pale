<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi mathvariant="normal">∣</mi><mi>S</mi><mi mathvariant="normal">∣</mi><mo>=</mo><mi>t</mi><mo separator="true">,</mo><mspace width="2em"/><mi>S</mi><mo>⊆</mo><mi>E</mi><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">∀</mi><mi>s</mi><mo>∈</mo><mi>S</mi><mo>:</mo><mtext>  </mtext><mi>s</mi><mi mathvariant="normal">.</mi><mi mathvariant="normal">digest</mi><mo>⁡</mo><mo>=</mo><mi>H</mi><mo stretchy="false">(</mo><msub><mi>P</mi><mrow><mi mathvariant="normal">u</mi><mi mathvariant="normal">n</mi><mi mathvariant="normal">s</mi><mi mathvariant="normal">i</mi><mi mathvariant="normal">g</mi><mi mathvariant="normal">n</mi><mi mathvariant="normal">e</mi><mi mathvariant="normal">d</mi></mrow></msub><mo stretchy="false">)</mo><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">|S|=t,&#92;qquad S&#92;subseteq E,&#92;qquad&#92;forall s&#92;in S:&#92;;s.&#92;operatorname{digest}=H(P&#95;{&#92;mathrm{unsigned}}).</annotation></semantics></math>
