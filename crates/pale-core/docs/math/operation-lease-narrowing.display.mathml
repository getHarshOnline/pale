<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi mathvariant="script">C</mi><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo><mo>⊆</mo><mi mathvariant="script">C</mi><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="1em"/><mi mathvariant="script">E</mi><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo><mo>⊆</mo><mi mathvariant="script">E</mi><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="1em"/><mi mathvariant="script">R</mi><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo><mo>⊆</mo><mi mathvariant="script">R</mi><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="1em"/><mi mathvariant="normal">Ω</mi><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo><mo>⊆</mo><mi mathvariant="normal">Ω</mi><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><mi>b</mi><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo><mo>≤</mo><mi>b</mi><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="1em"/><mi>t</mi><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo><mo>≤</mo><mi>t</mi><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="1em"/><mi>x</mi><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo><mo>≤</mo><mi>x</mi><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">&#92;mathcal{C}(L)&#92;subseteq&#92;mathcal{C}(S),&#92;quad &#92;mathcal{E}(L)&#92;subseteq&#92;mathcal{E}(S),&#92;quad &#92;mathcal{R}(L)&#92;subseteq&#92;mathcal{R}(S),&#92;quad &#92;Omega(S)&#92;subseteq&#92;Omega(L),&#92;qquad b(L)&#92;leq b(S),&#92;quad t(L)&#92;leq t(S),&#92;quad x(L)&#92;leq x(S).</annotation></semantics></math>
