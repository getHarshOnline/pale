<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi mathvariant="normal">merge</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>E</mi><mo separator="true">,</mo><mi>D</mi><mo stretchy="false">)</mo><mo>=</mo><mi mathvariant="normal">preserve</mi><mo>⁡</mo><mtext> ⁣</mtext><mrow><mo fence="true">(</mo><mi>E</mi><mo>∖</mo><mi mathvariant="normal">handlers</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>D</mi><mi mathvariant="normal">.</mi><mi mathvariant="normal">key</mi><mo>⁡</mo><mo stretchy="false">)</mo><mo fence="true">)</mo></mrow><mo>∪</mo><mi>D</mi><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">&#92;operatorname{merge}(E,D)=&#92;operatorname{preserve}&#92;!&#92;left(E&#92;setminus&#92;operatorname{handlers}(D.&#92;operatorname{key})&#92;right)&#92;cup D.</annotation></semantics></math>
