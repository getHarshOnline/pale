{
  "$defs": {
    "CanonicalSignatureV1": {
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$",
      "type": "string"
    },
    "ControlIncarnationIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ControlStoreIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "DeploymentRuntimeAuthorityEpochV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "DeploymentRuntimeAuthorityIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "Ed25519PublicKeyV1": {
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
      "type": "string"
    },
    "PrincipalAuthorityStateV1": {
      "oneOf": [
        {
          "const": "active",
          "type": "string"
        },
        {
          "const": "retired",
          "type": "string"
        }
      ]
    },
    "PrincipalKeyEpochV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "ResidentKeyIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentPrincipalIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentRecordRefV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "SchemaId": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$",
      "type": "string"
    },
    "SigningKeyEpochV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "UnixTimeV1": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "$id": "https://www.rawthoughts.in/pale/schemas/deployment-runtime-authority.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "dependentRequired": {
    "previous_authority_ref": [
      "previous_authority_sha256"
    ],
    "previous_authority_sha256": [
      "previous_authority_ref"
    ]
  },
  "properties": {
    "authority_epoch": {
      "$ref": "#/$defs/DeploymentRuntimeAuthorityEpochV1"
    },
    "canonical_deployment_runtime_authority_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "control_incarnation_id": {
      "$ref": "#/$defs/ControlIncarnationIdV1"
    },
    "control_store_id": {
      "$ref": "#/$defs/ControlStoreIdV1"
    },
    "deployment_binding_ref": {
      "$ref": "#/$defs/ResidentRecordRefV1"
    },
    "deployment_binding_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "expires_at": {
      "$ref": "#/$defs/UnixTimeV1"
    },
    "issued_at": {
      "$ref": "#/$defs/UnixTimeV1"
    },
    "issuer_key_epoch": {
      "$ref": "#/$defs/PrincipalKeyEpochV1"
    },
    "issuer_key_id": {
      "$ref": "#/$defs/ResidentKeyIdV1"
    },
    "issuer_principal_id": {
      "$ref": "#/$defs/ResidentPrincipalIdV1"
    },
    "permitted_record_schema_ids": {
      "items": {
        "$ref": "#/$defs/SchemaId"
      },
      "maxItems": 1024,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "previous_authority_ref": {
      "$ref": "#/$defs/ResidentRecordRefV1"
    },
    "previous_authority_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "principal_id": {
      "$ref": "#/$defs/ResidentPrincipalIdV1"
    },
    "runtime_authority_id": {
      "$ref": "#/$defs/DeploymentRuntimeAuthorityIdV1"
    },
    "schema_id": {
      "$ref": "#/$defs/SchemaId",
      "const": "pale/deployment-runtime-authority.v1"
    },
    "schema_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "signature": {
      "$ref": "#/$defs/CanonicalSignatureV1"
    },
    "state": {
      "$ref": "#/$defs/PrincipalAuthorityStateV1"
    },
    "subject_key_epoch": {
      "$ref": "#/$defs/SigningKeyEpochV1"
    },
    "subject_key_id": {
      "$ref": "#/$defs/ResidentKeyIdV1"
    },
    "subject_public_key": {
      "$ref": "#/$defs/Ed25519PublicKeyV1"
    }
  },
  "required": [
    "schema_id",
    "schema_sha256",
    "runtime_authority_id",
    "principal_id",
    "deployment_binding_ref",
    "deployment_binding_sha256",
    "control_store_id",
    "control_incarnation_id",
    "subject_key_id",
    "subject_key_epoch",
    "subject_public_key",
    "permitted_record_schema_ids",
    "authority_epoch",
    "state",
    "issued_at",
    "expires_at",
    "issuer_principal_id",
    "issuer_key_id",
    "issuer_key_epoch",
    "canonical_deployment_runtime_authority_sha256",
    "signature"
  ],
  "title": "deployment-runtime-authority.v1",
  "type": "object"
}
