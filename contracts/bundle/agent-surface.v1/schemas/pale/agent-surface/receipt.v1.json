          "required": [
            "target",
            "post_sha256"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "post_sha256": {
              "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
            },
            "pre_sha256": {
              "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
            },
            "target": {
              "const": "existing_file",
              "type": "string"
            }
          },
          "required": [
            "target",
            "pre_sha256",
            "post_sha256"
          ],
          "type": "object"
        }
      ]
    },
    "SurfaceOperationObservationV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "create",
              "type": "string"
