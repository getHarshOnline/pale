            "disposition": {
              "$ref": "#/$defs/UnchangedDispositionV1"
            },
            "sha256": {
              "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
            }
          },
          "required": [
            "action",
            "sha256",
            "disposition"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "delete",
              "type": "string"
            },
            "pre_sha256": {
              "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
            }
          },
          "required": [
            "action",
            "pre_sha256"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "splice",
              "type": "string"
            },
            "post_sha256": {
              "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
            },
            "pre_sha256": {
              "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
            }
          },
          "required": [
            "action",
            "pre_sha256",
            "post_sha256"
          ],
          "type": "object"
        }
      ]
    },
    "UnchangedDispositionV1": {
      "oneOf": [
        {
          "const": "verified",
          "type": "string"
        },
        {
          "const": "mode_repaired",
          "type": "string"
        }
      ]
    },
    "UnixFileMode": {
      "format": "uint32",
      "maximum": 4095,
      "minimum": 0,
      "type": "integer"
    }
