      "$ref": "#/$defs/ControlTransactionSequenceV1"
    },
    "control_checkpoint_id": {
      "$ref": "#/$defs/ControlCheckpointIdV1"
    },
    "control_incarnation_id": {
      "$ref": "#/$defs/ControlIncarnationIdV1"
    },
    "control_schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "control_store_id": {
      "$ref": "#/$defs/ControlStoreIdV1"
    },
    "domain_epoch": {
      "$ref": "#/$defs/ControlDomainEpochV1"
    },
    "domain_sequence": {
      "$ref": "#/$defs/ControlDomainSequenceV1"
    },
    "issued_at": {
      "$ref": "#/$defs/UnixTimeV1"
    },
    "issuer_key_epoch": {
      "$ref": "#/$defs/SigningKeyEpochV1"
    },
    "issuer_key_id": {
      "$ref": "#/$defs/ResidentKeyIdV1"
    },
    "issuer_principal_id": {
      "$ref": "#/$defs/ResidentPrincipalIdV1"
    },
    "leaf_count": {
      "$ref": "#/$defs/ControlLeafCountV1"
    },
    "previous_control_checkpoint_ref": {
      "$ref": "#/$defs/ResidentRecordRefV1"
    },
    "previous_control_checkpoint_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "schema_id": {
      "$ref": "#/$defs/SchemaId",
      "const": "pale/control-state-checkpoint.v1"
    },
    "schema_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "signature": {
      "$ref": "#/$defs/CanonicalSignatureV1"
    },
    "state_root_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "unresolved_custody_root_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    }
  },
  "required": [
    "schema_id",
    "schema_sha256",
    "control_checkpoint_id",
    "control_store_id",
    "control_incarnation_id",
    "checkpoint_domain_id",
    "domain_epoch",
    "domain_sequence",
    "checkpoint_profile_ref",
    "checkpoint_profile_sha256",
    "control_schema_version",
    "committed_transaction_sequence",
    "state_root_sha256",
    "leaf_count",
    "changed_leaf_keys",
    "unresolved_custody_root_sha256",
    "issued_at",
    "checkpoint_signing_authority_ref",
    "checkpoint_signing_authority_sha256",
    "issuer_principal_id",
    "issuer_key_id",
    "issuer_key_epoch",
    "canonical_control_checkpoint_sha256",
    "signature"
