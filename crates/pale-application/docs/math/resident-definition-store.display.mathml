<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi mathvariant="script">D</mi><mo stretchy="false">&#91;</mo><mi>G</mi><mo stretchy="false">&#93;</mo><mo>=</mo><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">&#91;</mo><mi>G</mi><mo stretchy="false">&#93;</mo><mo separator="true">,</mo><mi>E</mi><mo stretchy="false">&#91;</mo><mi>G</mi><mo stretchy="false">&#93;</mo><mo separator="true">,</mo><mi>B</mi><mo stretchy="false">&#91;</mo><mi>G</mi><mo stretchy="false">&#93;</mo><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">∣</mi><mi>V</mi><mo stretchy="false">&#91;</mo><mi>G</mi><mo stretchy="false">&#93;</mo><mi mathvariant="normal">∣</mi><mo>=</mo><mi mathvariant="normal">∣</mi><mi>B</mi><mo stretchy="false">&#91;</mo><mi>G</mi><mo stretchy="false">&#93;</mo><mi mathvariant="normal">∣</mi><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">subject</mi><mo>⁡</mo><mo>⟶</mo><mi mathvariant="normal">observer</mi><mo>⁡</mo><mo separator="true">,</mo><mspace width="2em"/><msub><mi>E</mi><mrow><mi mathvariant="normal">r</mi><mi mathvariant="normal">e</mi><mi mathvariant="normal">s</mi><mi mathvariant="normal">i</mi><mi mathvariant="normal">d</mi><mi mathvariant="normal">e</mi><mi mathvariant="normal">n</mi><mi mathvariant="normal">t</mi></mrow></msub><mo>:</mo><mi mathvariant="normal">observer</mi><mo>⁡</mo><mo>⟶</mo><mi mathvariant="normal">subject</mi><mo>⁡</mo><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">&#92;mathcal{D}&#91;G&#93;=(V&#91;G&#93;,E&#91;G&#93;,B&#91;G&#93;),&#92;qquad |V&#91;G&#93;|=|B&#91;G&#93;|,&#92;qquad &#92;operatorname{subject}&#92;longrightarrow&#92;operatorname{observer},&#92;qquad E&#95;{&#92;mathrm{resident}}:&#92;operatorname{observer}&#92;longrightarrow&#92;operatorname{subject}.</annotation></semantics></math>
