<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi mathvariant="normal">settle</mi><mo>⁡</mo><mo>=</mo><mo stretchy="false">{</mo><mi mathvariant="normal">published</mi><mo>⁡</mo><mo>↦</mo><mi mathvariant="normal">commit</mi><mo>⁡</mo><mo separator="true">,</mo><mtext> </mtext><mo stretchy="false">{</mo><mi mathvariant="normal">absent</mi><mo>⁡</mo><mo separator="true">,</mo><mi mathvariant="normal">collision</mi><mo>⁡</mo><mo stretchy="false">}</mo><mo>↦</mo><mi mathvariant="normal">rollback</mi><mo>⁡</mo><mo separator="true">,</mo><mtext> </mtext><mi mathvariant="normal">uncertain</mi><mo>⁡</mo><mo>↦</mo><mi mathvariant="normal">retain</mi><mo>⁡</mo><mo stretchy="false">}</mo><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">&#92;operatorname{settle}=&#92;{&#92;operatorname{published}&#92;mapsto&#92;operatorname{commit},&#92; &#92;{&#92;operatorname{absent},&#92;operatorname{collision}&#92;}&#92;mapsto&#92;operatorname{rollback},&#92; &#92;operatorname{uncertain}&#92;mapsto&#92;operatorname{retain}&#92;}.</annotation></semantics></math>
