<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi>b</mi><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo><mo>=</mo><mi>min</mi><mo>⁡</mo><mtext> ⁣</mtext><mrow><mo fence="true">(</mo><mi>M</mi><mo separator="true">,</mo><mi>I</mi><mo>⋅</mo><msup><mn>2</mn><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo fence="true">)</mo></mrow><mo separator="true">,</mo><mspace width="2em"/><msub><mi>T</mi><mrow><mi mathvariant="normal">c</mi><mi mathvariant="normal">l</mi><mi mathvariant="normal">o</mi><mi mathvariant="normal">s</mi><mi mathvariant="normal">u</mi><mi mathvariant="normal">r</mi><mi mathvariant="normal">e</mi></mrow></msub><mo>∈</mo><mi>O</mi><mo stretchy="false">(</mo><mi mathvariant="normal">∣</mi><mi>S</mi><msup><mi mathvariant="normal">∣</mi><mn>3</mn></msup><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="1em"/><msub><mi>M</mi><mrow><mi mathvariant="normal">c</mi><mi mathvariant="normal">l</mi><mi mathvariant="normal">o</mi><mi mathvariant="normal">s</mi><mi mathvariant="normal">u</mi><mi mathvariant="normal">r</mi><mi mathvariant="normal">e</mi></mrow></msub><mo>∈</mo><mi>O</mi><mo stretchy="false">(</mo><mi mathvariant="normal">∣</mi><mi>S</mi><msup><mi mathvariant="normal">∣</mi><mn>2</mn></msup><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><msub><mi>T</mi><mrow><mi mathvariant="normal">a</mi><mi mathvariant="normal">d</mi><mi mathvariant="normal">m</mi><mi mathvariant="normal">i</mi><mi mathvariant="normal">t</mi></mrow></msub><mo>∈</mo><mi>O</mi><mo stretchy="false">(</mo><mi mathvariant="normal">∣</mi><mi>S</mi><mi mathvariant="normal">∣</mi><mi>log</mi><mo>⁡</mo><mi mathvariant="normal">∣</mi><mi>S</mi><mi mathvariant="normal">∣</mi><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="1em"/><msub><mi>T</mi><mrow><mi mathvariant="normal">r</mi><mi mathvariant="normal">e</mi><mi mathvariant="normal">c</mi><mi mathvariant="normal">o</mi><mi mathvariant="normal">n</mi><mi mathvariant="normal">c</mi><mi mathvariant="normal">i</mi><mi mathvariant="normal">l</mi><mi mathvariant="normal">e</mi></mrow></msub><mo>∈</mo><mi>O</mi><mo stretchy="false">(</mo><mi mathvariant="normal">∣</mi><mi>S</mi><msup><mi mathvariant="normal">∣</mi><mn>2</mn></msup><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">prepare</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>p</mi><mo separator="true">,</mo><mi>d</mi><mo separator="true">,</mo><mi>o</mi><mo separator="true">,</mo><mi>ι</mi><mo stretchy="false">)</mo><mo>⟶</mo><mi mathvariant="normal">pending</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>d</mi><mo separator="true">,</mo><mi mathvariant="normal">intents</mi><mo>⁡</mo><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">sequence</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>p</mi><mo separator="true">,</mo><mi>d</mi><mo separator="true">,</mo><mi>o</mi><mo separator="true">,</mo><mi>ι</mi><mo stretchy="false">)</mo><mo>=</mo><mi mathvariant="normal">persist</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo><mo separator="true">;</mo><mo stretchy="false">&#91;</mo><mi mathvariant="normal">sentinel</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo><mo stretchy="false">&#93;</mo><mo lspace="0.22em" rspace="0.22em"><mo>+</mo><mtext> ⁣</mtext><mo>+</mo></mo><mi mathvariant="normal">intents</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>p</mi><mo separator="true">,</mo><mi>d</mi><mo separator="true">,</mo><mi>o</mi><mo separator="true">,</mo><mi>ι</mi><mo stretchy="false">)</mo><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">b(n)=&#92;min&#92;!&#92;left(M,I&#92;cdot2^{n-1}&#92;right),&#92;qquad T&#95;{&#92;mathrm{closure}}&#92;in O(|S|^3),&#92;quad M&#95;{&#92;mathrm{closure}}&#92;in O(|S|^2),&#92;qquad T&#95;{&#92;mathrm{admit}}&#92;in O(|S|&#92;log|S|),&#92;quad T&#95;{&#92;mathrm{reconcile}}&#92;in O(|S|^2),&#92;qquad &#92;operatorname{prepare}(p,d,o,&#92;iota)&#92;longrightarrow&#92;operatorname{pending}(d,&#92;operatorname{intents}),&#92;qquad &#92;operatorname{sequence}(p,d,o,&#92;iota)=&#92;operatorname{persist}(d);&#91;&#92;operatorname{sentinel}(d)&#93;&#92;mathbin{+&#92;!+}&#92;operatorname{intents}(p,d,o,&#92;iota).</annotation></semantics></math>
