<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi mathvariant="normal">reject</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>s</mi><mo separator="true">,</mo><mi>t</mi><mo stretchy="false">)</mo><mtext>  </mtext><mo>⟺</mo><mtext>  </mtext><mi>c</mi><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo><mo mathvariant="normal">≠</mo><mi>c</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo>∧</mo><mi>τ</mi><mtext> ⁣</mtext><mrow><mo fence="true">(</mo><mi>c</mi><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo><mo fence="true">)</mo></mrow><mo>≥</mo><mi>τ</mi><mtext> ⁣</mtext><mrow><mo fence="true">(</mo><mi>c</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo fence="true">)</mo></mrow></mrow><annotation encoding="application/x-tex">&#92;operatorname{reject}(s,t) &#92;iff c(s) &#92;ne c(t) &#92;land &#92;tau&#92;!&#92;left(c(s)&#92;right) &#92;ge &#92;tau&#92;!&#92;left(c(t)&#92;right)</annotation></semantics></math>
