{
  "$defs": {
    "CanonicalSignatureV1": {
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$",
      "type": "string"
    },
    "ControlIncarnationIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ControlStoreIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "PrincipalKeyEpochV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "PrincipalResidentWriterFenceIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "PrincipalResidentWriterFenceStateV1": {
      "oneOf": [
        {
          "const": "active",
          "type": "string"
        },
        {
          "const": "retired",
          "type": "string"
        }
      ]
    },
    "PrincipalResidentWriterGenerationV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "PrincipalSessionFloorEpochV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "ResidentBootIncarnationIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentKeyIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentNodeIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentPrincipalIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentProcessInstanceIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentRecordRefV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "SchemaId": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$",
      "type": "string"
    },
    "UnixTimeV1": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "$id": "https://www.rawthoughts.in/pale/schemas/principal-resident-writer-fence.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acquired_at": {
      "$ref": "#/$defs/UnixTimeV1"
    },
    "boot_incarnation_id": {
      "$ref": "#/$defs/ResidentBootIncarnationIdV1"
    },
    "canonical_principal_resident_writer_fence_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "issuer_key_epoch": {
      "$ref": "#/$defs/PrincipalKeyEpochV1"
    },
    "issuer_key_id": {
      "$ref": "#/$defs/ResidentKeyIdV1"
    },
    "issuer_principal_id": {
      "$ref": "#/$defs/ResidentPrincipalIdV1"
    },
    "opened_deployment_store_heads_root_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "previous_writer_fence_ref": {
      "$ref": "#/$defs/ResidentRecordRefV1"
    },
    "previous_writer_fence_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "primary_node_id": {
      "$ref": "#/$defs/ResidentNodeIdV1"
    },
    "principal_id": {
      "$ref": "#/$defs/ResidentPrincipalIdV1"
    },
    "principal_session_floor_epoch": {
      "$ref": "#/$defs/PrincipalSessionFloorEpochV1"
    },
    "prior_terminal_receipt_ref": {
      "$ref": "#/$defs/ResidentRecordRefV1"
    },
    "prior_terminal_receipt_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "process_instance_id": {
      "$ref": "#/$defs/ResidentProcessInstanceIdV1"
    },
    "retired_at": {
      "$ref": "#/$defs/UnixTimeV1"
    },
    "schema_id": {
      "$ref": "#/$defs/SchemaId",
      "const": "pale/principal-resident-writer-fence.v1"
    },
    "schema_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "signature": {
      "$ref": "#/$defs/CanonicalSignatureV1"
    },
    "state": {
      "$ref": "#/$defs/PrincipalResidentWriterFenceStateV1"
    },
    "takeover_receipt_ref": {
      "$ref": "#/$defs/ResidentRecordRefV1"
    },
    "takeover_receipt_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "trust_store_id": {
      "$ref": "#/$defs/ControlStoreIdV1"
    },
    "trust_store_incarnation_id": {
      "$ref": "#/$defs/ControlIncarnationIdV1"
    },
    "writer_fence_id": {
      "$ref": "#/$defs/PrincipalResidentWriterFenceIdV1"
    },
    "writer_generation": {
      "$ref": "#/$defs/PrincipalResidentWriterGenerationV1"
    }
