<math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi mathvariant="normal">retire</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo><mo>=</mo><mi>g</mi><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">acquire&#95;next</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo><mo>=</mo><mi mathvariant="normal">takeover</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo><mo>=</mo><mi>g</mi><mo>+</mo><mn>1.</mn></mrow><annotation encoding="application/x-tex">&#92;operatorname{retire}(g)=g,&#92;qquad &#92;operatorname{acquire&#92;&#95;next}(g)=&#92;operatorname{takeover}(g)=g+1.</annotation></semantics></math>
