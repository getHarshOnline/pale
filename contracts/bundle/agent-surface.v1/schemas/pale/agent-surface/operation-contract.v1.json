{
  "$defs": {
    "Approval": {
      "oneOf": [
        {
          "const": "none",
          "type": "string"
        },
        {
          "const": "ask",
          "type": "string"
        },
        {
          "const": "gated",
          "type": "string"
        }
      ]
    },
    "CapabilityIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "CapabilityRequirementIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "DegradedOutcomeIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "EffectClass": {
      "oneOf": [
        {
          "const": "compute",
          "type": "string"
        },
        {
          "const": "read",
          "type": "string"
        },
        {
          "const": "execute",
          "type": "string"
        },
        {
          "const": "write",
          "type": "string"
        },
        {
          "const": "network",
          "type": "string"
        },
        {
          "const": "publish",
          "type": "string"
        }
      ]
    },
    "FailurePosture": {
      "oneOf": [
        {
          "const": "fail_closed",
          "type": "string"
        },
        {
          "const": "fail_open",
          "type": "string"
        },
        {
          "const": "retry",
          "type": "string"
        },
        {
          "const": "steer",
          "type": "string"
        },
        {
          "const": "escalate",
          "type": "string"
        }
      ]
    },
    "HostCommandConstraint": {
      "additionalProperties": false,
      "properties": {
        "allow_trailing_args": {
          "default": false,
          "type": "boolean"
        },
        "argv_prefix": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "executable": {
          "type": "string"
        }
      },
      "required": [
        "executable"
      ],
      "type": "object"
    },
    "HostCommandSource": {
      "oneOf": [
        {
          "const": "repository_capability_commands",
          "type": "string"
        }
      ]
    },
    "HostToolBinding": {
      "additionalProperties": false,
      "properties": {
        "command_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/HostCommandSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "commands": {
          "items": {
            "$ref": "#/$defs/HostCommandConstraint"
          },
          "type": "array"
        },
        "input_equals": {
          "additionalProperties": false,
          "patternProperties": {
            "^/(?:[^~\\u0000-\\u001F\\u007F-\\u009F]|~[01])+$": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "model_name": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "observability": {
          "$ref": "#/$defs/ToolObservability"
        }
      },
      "required": [
        "name",
        "observability"
      ],
      "type": "object"
    },
    "HostedProviderExecutionV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "host_tools": {
              "items": {
                "$ref": "#/$defs/HostToolBinding"
              },
              "minItems": 1,
              "type": "array"
            },
            "kind": {
              "const": "available",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "host_tools"
          ],
          "type": "object"
        }
      ]
    },
    "NativeRustProviderExecutionV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "host_tools": {
              "items": {
                "$ref": "#/$defs/HostToolBinding"
              },
              "minItems": 1,
              "type": "array"
            },
            "kind": {
              "const": "available",
              "type": "string"
            },
            "native_action": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "host_tools",
            "native_action"
          ],
          "type": "object"
        }
      ]
    },
    "OperationCapabilityContractV1": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "$ref": "#/$defs/CapabilityIdV1"
        },
        "effect_class": {
          "$ref": "#/$defs/EffectClass"
        },
        "failure_posture": {
          "$ref": "#/$defs/FailurePosture"
        },
        "policy": {
          "$ref": "#/$defs/ResolvedCapabilityRequirementPolicyV1"
        },
        "provider_state": {
          "$ref": "#/$defs/OperationCapabilityProviderStateV1"
        },
        "recipe": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageResourceRefV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "requirement_id": {
          "$ref": "#/$defs/CapabilityRequirementIdV1"
        }
      },
      "required": [
        "requirement_id",
        "capability_id",
        "effect_class",
        "policy",
        "failure_posture",
        "provider_state"
      ],
      "type": "object"
    },
    "OperationCapabilityProviderStateV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unbound",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "approval": {
              "$ref": "#/$defs/Approval"
            },
            "kind": {
              "const": "bound",
              "type": "string"
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            },
            "provider": {
              "$ref": "#/$defs/RouteCapabilityProviderV1"
            }
          },
          "required": [
            "kind",
            "approval",
            "provider"
          ],
          "type": "object"
        }
      ]
    },
    "OperationContractMechanicsV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "semantic_only",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "capabilities": {
              "items": {
                "$ref": "#/$defs/OperationCapabilityContractV1"
              },
              "minItems": 1,
              "type": "array"
            },
            "kind": {
              "const": "capability_bearing",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "capabilities"
          ],
          "type": "object"
        }
      ]
    },
    "OperationDispatchV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "aliases": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "invocation": {
              "type": "string"
            },
            "kind": {
              "const": "model_or_user",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "invocation"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "aliases": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "invocation": {
              "type": "string"
            },
            "kind": {
              "const": "user_only",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "invocation"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "internal",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "OperationSemanticDependencyV1": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sealed-artifact.v1.json"
        },
        "id": {
          "$ref": "#/$defs/PackageResourceRefV1"
        },
        "kind": {
          "$ref": "#/$defs/SemanticDependencyKind"
        }
      },
      "required": [
        "kind",
        "id",
        "artifact"
      ],
      "type": "object"
    },
    "PackageIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "PackageResourceIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:[./][a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "PackageResourceRefV1": {
      "additionalProperties": false,
      "properties": {
        "package_id": {
          "$ref": "#/$defs/PackageIdV1"
        },
        "resource_id": {
          "$ref": "#/$defs/PackageResourceIdV1"
        }
      },
      "required": [
        "package_id",
        "resource_id"
      ],
      "type": "object"
    },
    "ResolvedCapabilityFallbackV1": {
      "additionalProperties": false,
      "properties": {
        "guidance": {
          "minLength": 1,
          "type": "string"
        },
        "recipe": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageResourceRefV1"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "guidance"
      ],
      "type": "object"
    },
    "ResolvedCapabilityRequirementPolicyV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "required_block",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "degraded_outcome": {
              "$ref": "#/$defs/DegradedOutcomeIdV1"
            },
            "fallback": {
              "$ref": "#/$defs/ResolvedCapabilityFallbackV1"
            },
            "kind": {
              "const": "required_degrade",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "fallback",
            "degraded_outcome"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "fallback": {
              "$ref": "#/$defs/ResolvedCapabilityFallbackV1"
            },
            "kind": {
              "const": "optional",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "fallback"
          ],
          "type": "object"
        }
      ]
    },
    "RouteCapabilityProviderV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "execution": {
              "$ref": "#/$defs/HostedProviderExecutionV1"
            },
            "kind": {
              "const": "host_native",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "execution"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "execution": {
              "$ref": "#/$defs/NativeRustProviderExecutionV1"
            },
            "kind": {
              "const": "native_rust",
              "type": "string"
            },
            "target": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "target",
            "execution"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "execution": {
              "$ref": "#/$defs/HostedProviderExecutionV1"
            },
            "kind": {
              "const": "connector",
              "type": "string"
            },
            "target": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "target",
            "execution"
          ],
          "type": "object"
        }
      ]
    },
    "SemanticDependencyKind": {
      "oneOf": [
        {
          "const": "doctrine",
          "type": "string"
        },
        {
          "const": "role",
          "type": "string"
        },
        {
          "const": "tool",
          "type": "string"
        }
      ]
    },
    "ToolObservability": {
      "oneOf": [
        {
          "const": "pre_tool_observable",
          "type": "string"
        },
        {
          "const": "permission_only",
          "type": "string"
        },
        {
          "const": "unobservable",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://www.rawthoughts.in/pale/schemas/operation-contract.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "auxiliary_tools": {
      "items": {
        "$ref": "#/$defs/HostToolBinding"
      },
      "type": "array"
    },
    "contract_digest": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "dispatch": {
      "$ref": "#/$defs/OperationDispatchV1"
    },
    "id": {
      "$ref": "#/$defs/PackageResourceRefV1"
    },
    "invocation_policy": {
      "anyOf": [
        {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sealed-artifact.v1.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "mechanics": {
      "$ref": "#/$defs/OperationContractMechanicsV1"
    },
    "roles": {
      "items": {
        "$ref": "#/$defs/PackageResourceRefV1"
      },
      "type": "array"
    },
    "schema": {
      "const": "pale/operation-contract.v1",
      "type": "string"
    },
    "schema_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "schema_version": {
      "const": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "semantic_dependencies": {
      "items": {
        "$ref": "#/$defs/OperationSemanticDependencyV1"
      },
      "type": "array"
    },
    "skill": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sealed-artifact.v1.json"
    }
  },
  "required": [
    "schema",
    "schema_sha256",
    "schema_version",
    "id",
    "dispatch",
    "mechanics",
    "skill",
    "contract_digest"
  ],
  "title": "operation-contract.v1",
  "type": "object"
}
