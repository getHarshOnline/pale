{
  "$defs": {
    "CapabilityIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "ChildPropagation": {
      "oneOf": [
        {
          "const": "propagate",
          "type": "string"
        },
        {
          "const": "exempt",
          "type": "string"
        },
        {
          "const": "none",
          "type": "string"
        }
      ]
    },
    "DurableEvidenceBinding": {
      "additionalProperties": false,
      "properties": {
        "retention_seconds": {
          "$ref": "#/$defs/EvidenceRetentionSeconds"
        },
        "root": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "root",
        "retention_seconds"
      ],
      "type": "object"
    },
    "EffectClass": {
      "oneOf": [
        {
          "const": "compute",
          "type": "string"
        },
        {
          "const": "read",
          "type": "string"
        },
        {
          "const": "execute",
          "type": "string"
        },
        {
          "const": "write",
          "type": "string"
        },
        {
          "const": "network",
          "type": "string"
        },
        {
          "const": "publish",
          "type": "string"
        }
      ]
    },
    "EvidenceRetentionSeconds": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "ExecutionPathSelectionIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:[.:/][a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "ExecutionPathSelectionV1": {
      "additionalProperties": false,
      "properties": {
        "experience_path_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._/-]+$",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ExecutionPathSelectionIdV1"
        }
      },
      "required": [
        "id",
        "experience_path_id"
      ],
      "type": "object"
    },
    "ExecutionPathWitnessV1": {
      "additionalProperties": false,
      "properties": {
        "composition_plan_digest": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        },
        "responsibility_path_identity": {
          "$ref": "#/$defs/ResponsibilityPathIdentityV1"
        },
        "selection": {
          "$ref": "#/$defs/ExecutionPathSelectionV1"
        },
        "terminal_provider_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderBindingRefV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "work_delegation_edge_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._/-]+$",
            "type": "string"
          },
          "maxItems": 256,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "selection",
        "responsibility_path_identity",
        "work_delegation_edge_ids",
        "composition_plan_digest"
      ],
      "type": "object"
    },
    "FailurePosture": {
      "oneOf": [
        {
          "const": "fail_closed",
          "type": "string"
        },
        {
          "const": "fail_open",
          "type": "string"
        },
        {
          "const": "retry",
          "type": "string"
        },
        {
          "const": "steer",
          "type": "string"
        },
        {
          "const": "escalate",
          "type": "string"
        }
      ]
    },
    "HostCommandConstraint": {
      "additionalProperties": false,
      "properties": {
        "allow_trailing_args": {
          "default": false,
          "type": "boolean"
        },
        "argv_prefix": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "executable": {
          "type": "string"
        }
      },
      "required": [
        "executable"
      ],
      "type": "object"
    },
    "HostCommandSource": {
      "oneOf": [
        {
          "const": "repository_capability_commands",
          "type": "string"
        }
      ]
    },
    "HostToolBinding": {
      "additionalProperties": false,
      "properties": {
        "command_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/HostCommandSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "commands": {
          "items": {
            "$ref": "#/$defs/HostCommandConstraint"
          },
          "type": "array"
        },
        "input_equals": {
          "additionalProperties": false,
          "patternProperties": {
            "^/(?:[^~\\u0000-\\u001F\\u007F-\\u009F]|~[01])+$": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "model_name": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "observability": {
          "$ref": "#/$defs/ToolObservability"
        }
      },
      "required": [
        "name",
        "observability"
      ],
      "type": "object"
    },
    "HostToolEffectBinding": {
      "additionalProperties": false,
      "properties": {
        "effect_class": {
          "$ref": "#/$defs/EffectClass"
        },
        "tool": {
          "$ref": "#/$defs/HostToolBinding"
        }
      },
      "required": [
        "effect_class",
        "tool"
      ],
      "type": "object"
    },
    "LifecycleAction": {
      "oneOf": [
        {
          "const": "inject",
          "type": "string"
        },
        {
          "const": "inject_modes",
          "type": "string"
        },
        {
          "const": "deny",
          "type": "string"
        },
        {
          "const": "ask",
          "type": "string"
        },
        {
          "const": "warn",
          "type": "string"
        },
        {
          "const": "guide",
          "type": "string"
        },
        {
          "const": "notify",
          "type": "string"
        },
        {
          "const": "capture",
          "type": "string"
        },
        {
          "const": "activate",
          "type": "string"
        },
        {
          "const": "deactivate",
          "type": "string"
        },
        {
          "const": "rebaseline",
          "type": "string"
        },
        {
          "const": "signal",
          "type": "string"
        },
        {
          "const": "no_op",
          "type": "string"
        }
      ]
    },
    "LifecycleBehavior": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/LifecycleAction"
        },
        "activate_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageResourceRefV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "allow_admitted_operation": {
          "default": false,
          "type": "boolean"
        },
        "case_insensitive": {
          "default": false,
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "event": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/lifecycle-event.v1.json"
        },
        "existing_targets_only": {
          "default": false,
          "type": "boolean"
        },
        "failure_posture": {
          "$ref": "#/$defs/FailurePosture",
          "default": "fail_closed"
        },
        "fallback": {
          "anyOf": [
            {
              "$ref": "#/$defs/LifecycleFallbackV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "governed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "guidance": {
          "anyOf": [
            {
              "$ref": "#/$defs/OwnedConfinedRelativePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/LifecycleBehaviorIdV1"
        },
        "matchers": {
          "default": [],
          "items": {
            "maxLength": 4096,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "modes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PackageResourceRefV1"
          },
          "type": "array"
        },
        "predicate_kind": {
          "$ref": "#/$defs/PredicateKind",
          "default": "always"
        },
        "state_scope": {
          "$ref": "#/$defs/StateScope",
          "default": "stateless"
        },
        "timeout_ms": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "tool_reqs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CapabilityIdV1"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "description",
        "event",
        "action"
      ],
      "type": "object"
    },
    "LifecycleBehaviorIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "LifecycleFallbackV1": {
      "additionalProperties": false,
      "properties": {
        "carrier_event": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/lifecycle-event.v1.json"
        },
        "guidance": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "guidance",
        "carrier_event"
      ],
      "type": "object"
    },
    "LogicalRepositoryIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:[.:/][a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "MaterializationLineageBinding": {
      "additionalProperties": false,
      "properties": {
        "max_route_records_per_collection": {
          "$ref": "#/$defs/RouteRecordLimit"
        },
        "root": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "root",
        "max_route_records_per_collection"
      ],
      "type": "object"
    },
    "ModeAxis": {
      "oneOf": [
        {
          "const": "intensity",
          "type": "string"
        },
        {
          "const": "task_stance",
          "type": "string"
        }
      ]
    },
    "OwnedConfinedRelativePath": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "PackageIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "PackageResourceIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:[./][a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "PackageResourceRefV1": {
      "additionalProperties": false,
      "properties": {
        "package_id": {
          "$ref": "#/$defs/PackageIdV1"
        },
        "resource_id": {
          "$ref": "#/$defs/PackageResourceIdV1"
        }
      },
      "required": [
        "package_id",
        "resource_id"
      ],
      "type": "object"
    },
    "PredicateKind": {
      "oneOf": [
        {
          "const": "always",
          "type": "string"
        },
        {
          "const": "tool_match",
          "type": "string"
        },
        {
          "const": "destructive_shell",
          "type": "string"
        },
        {
          "const": "git_hook_bypass",
          "type": "string"
        },
        {
          "const": "write_effect",
          "type": "string"
        },
        {
          "const": "path_match",
          "type": "string"
        },
        {
          "const": "command_prefix",
          "type": "string"
        },
        {
          "const": "exact_message",
          "type": "string"
        },
        {
          "const": "mode_changed",
          "type": "string"
        },
        {
          "const": "rebaseline_pending",
          "type": "string"
        },
        {
          "const": "first_touch",
          "type": "string"
        },
        {
          "const": "connector_bound",
          "type": "string"
        },
        {
          "const": "never",
          "type": "string"
        }
      ]
    },
    "ProviderBindingIdentityV1": {
      "additionalProperties": false,
      "properties": {
        "provider_binding_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        }
      },
      "required": [
        "provider_binding_sha256"
      ],
      "type": "object"
    },
    "ProviderBindingRefV1": {
      "additionalProperties": false,
      "properties": {
        "provider_binding_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._/-]+$",
          "type": "string"
        },
        "provider_binding_identity": {
          "$ref": "#/$defs/ProviderBindingIdentityV1"
        }
      },
      "required": [
        "provider_binding_id",
        "provider_binding_identity"
      ],
      "type": "object"
    },
    "RepositoryVerifierBinding": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "$ref": "#/$defs/CapabilityIdV1"
        },
        "command": {
          "$ref": "#/$defs/HostCommandConstraint"
        },
        "tool_name": {
          "type": "string"
        }
      },
      "required": [
        "capability_id",
        "tool_name",
        "command"
      ],
      "type": "object"
    },
    "ResponsibilityPathIdentityV1": {
      "additionalProperties": false,
      "properties": {
        "responsibility_path_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        }
      },
      "required": [
        "responsibility_path_sha256"
      ],
      "type": "object"
    },
    "RouteRecordLimit": {
      "format": "uint32",
      "maximum": 65536,
      "minimum": 1,
      "type": "integer"
    },
    "RunPolicyEntry": {
      "additionalProperties": false,
      "properties": {
        "action_gate": {
          "default": false,
          "type": "boolean"
        },
        "child_propagation": {
          "$ref": "#/$defs/ChildPropagation",
          "default": "propagate"
        },
        "child_type_selectors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "description": {
          "type": "string"
        },
        "gated_tool_matchers": {
          "default": [],
          "items": {
            "$ref": "https://www.rawthoughts.in/pale/schemas/tool-call-matcher.v1.json"
          },
          "maxItems": 256,
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/RunPolicyIdV1"
        },
        "session_inject": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "type": "object"
    },
    "RunPolicyIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "SealedRunMode": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "axis": {
          "$ref": "#/$defs/ModeAxis"
        },
        "body": {
          "anyOf": [
            {
              "$ref": "https://www.rawthoughts.in/pale/schemas/sealed-artifact.v1.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "exact_triggers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/PackageResourceRefV1"
        }
      },
      "required": [
        "id",
        "axis"
      ],
      "type": "object"
    },
    "SessionStateBinding": {
      "additionalProperties": false,
      "properties": {
        "root": {
          "minLength": 1,
          "type": "string"
        },
        "ttl_seconds": {
          "$ref": "#/$defs/SessionTtlSeconds"
        }
      },
      "required": [
        "root",
        "ttl_seconds"
      ],
      "type": "object"
    },
    "SessionTtlSeconds": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "StateScope": {
      "oneOf": [
        {
          "const": "stateless",
          "type": "string"
        },
        {
          "const": "message",
          "type": "string"
        },
        {
          "const": "session",
          "type": "string"
        },
        {
          "const": "durable",
          "type": "string"
        }
      ]
    },
    "ToolObservability": {
      "oneOf": [
        {
          "const": "pre_tool_observable",
          "type": "string"
        },
        {
          "const": "permission_only",
          "type": "string"
        },
        {
          "const": "unobservable",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://www.rawthoughts.in/pale/schemas/hook-context.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_plugin_id": {
      "type": "string"
    },
    "available_tool_requirements": {
      "items": {
        "$ref": "#/$defs/CapabilityIdV1"
      },
      "type": "array"
    },
    "behaviour_guidance": {
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sealed-artifact.v1.json"
        }
      },
      "type": "object"
    },
    "behaviours": {
      "items": {
        "$ref": "#/$defs/LifecycleBehavior"
      },
      "type": "array"
    },
    "compilation_input_digest": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "durable_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/DurableEvidenceBinding"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_path_witness": {
      "$ref": "#/$defs/ExecutionPathWitnessV1"
    },
    "host_tool_effects": {
      "items": {
        "$ref": "#/$defs/HostToolEffectBinding"
      },
      "type": "array"
    },
    "injection_digest": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "instance_digest": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "materialization_lineage": {
      "anyOf": [
        {
          "$ref": "#/$defs/MaterializationLineageBinding"
        },
        {
          "type": "null"
        }
      ]
    },
    "mode_defaults": {
      "additionalProperties": {
        "$ref": "#/$defs/PackageResourceRefV1"
      },
      "type": "object"
    },
    "native_harness_binding": {
      "anyOf": [
        {
          "$ref": "https://www.rawthoughts.in/pale/schemas/native-harness-binding.v1.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation_binding": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sealed-artifact.v1.json"
    },
    "profile_digest": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "projection_manifest": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sealed-artifact.v1.json"
    },
    "protected_runtime_dirs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "read_only_dirs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "repository_id": {
      "$ref": "#/$defs/LogicalRepositoryIdV1"
    },
    "repository_verifiers": {
      "items": {
        "$ref": "#/$defs/RepositoryVerifierBinding"
      },
      "type": "array"
    },
    "run_modes": {
      "items": {
        "$ref": "#/$defs/SealedRunMode"
      },
      "type": "array"
    },
    "run_policy": {
      "$ref": "#/$defs/RunPolicyEntry"
    },
    "schema": {
      "const": "pale.agent-surface.hook-context.v1",
      "type": "string"
    },
    "schema_manifest_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "schema_set_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "schema_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "schema_version": {
      "const": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "session_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionStateBinding"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "schema_sha256",
    "schema_version",
    "schema_manifest_sha256",
    "schema_set_sha256",
    "compilation_input_digest",
    "profile_digest",
    "instance_digest",
    "repository_id",
    "execution_path_witness",
    "adapter_plugin_id",
    "run_policy",
    "injection_digest",
    "projection_manifest",
    "operation_binding"
  ],
  "title": "hook-context.v1",
  "type": "object"
}
