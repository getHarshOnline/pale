{
  "$defs": {
    "BoundedResidentTextV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "CanonicalSignatureV1": {
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$",
      "type": "string"
    },
    "CapabilityAttemptIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "CapabilityFailureV1": {
      "additionalProperties": false,
      "properties": {
        "failure_ref": {
          "$ref": "#/$defs/ResidentRecordRefV1"
        },
        "failure_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        }
      },
      "required": [
        "failure_ref",
        "failure_sha256"
      ],
      "type": "object"
    },
    "CapabilityIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "CapabilityResultStatusV1": {
      "oneOf": [
        {
          "const": "succeeded",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        }
      ]
    },
    "CapabilitySuccessV1": {
      "additionalProperties": false,
      "oneOf": [
        {
          "not": {
            "required": [
              "immutable_result_ref"
            ]
          },
          "required": [
            "inline_payload"
          ]
        },
        {
          "not": {
            "required": [
              "inline_payload"
            ]
          },
          "required": [
            "immutable_result_ref"
          ]
        }
      ],
      "properties": {
        "immutable_result_ref": {
          "$ref": "#/$defs/ResidentRecordRefV1"
        },
        "inline_payload": {
          "not": {
            "type": "null"
          }
        },
        "result_payload_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        },
        "result_schema_id": {
          "$ref": "#/$defs/SchemaId"
        },
        "result_schema_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        }
      },
      "required": [
        "result_schema_id",
        "result_schema_sha256",
        "result_payload_sha256"
      ],
      "type": "object"
    },
    "IntegratedOwnerAuthorityV1": {
      "additionalProperties": false,
      "properties": {
        "checked_principal_trust_checkpoint_ref": {
          "$ref": "#/$defs/ResidentRecordRefV1"
        },
        "checked_principal_trust_checkpoint_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        },
        "owner_component_id": {
          "$ref": "#/$defs/OwnerComponentIdV1"
        },
        "owner_contract_manifest_ref": {
          "$ref": "#/$defs/ResidentRecordRefV1"
        },
        "owner_contract_manifest_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        },
        "owner_record_signing_authority_ref": {
          "$ref": "#/$defs/ResidentRecordRefV1"
        },
        "owner_record_signing_authority_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        },
        "owner_signer_record_sequence": {
          "$ref": "#/$defs/OwnerSignerRecordSequenceV1"
        },
        "previous_owner_record_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        }
      },
      "required": [
        "owner_component_id",
        "owner_record_signing_authority_ref",
        "owner_record_signing_authority_sha256",
        "owner_contract_manifest_ref",
        "owner_contract_manifest_sha256",
        "owner_signer_record_sequence",
        "checked_principal_trust_checkpoint_ref",
        "checked_principal_trust_checkpoint_sha256"
      ],
      "type": "object"
    },
    "IntegratedRuntimeAuthorityV1": {
      "additionalProperties": false,
      "properties": {
        "checked_principal_trust_checkpoint_ref": {
          "$ref": "#/$defs/ResidentRecordRefV1"
        },
        "checked_principal_trust_checkpoint_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        },
        "deployment_binding_ref": {
          "$ref": "#/$defs/ResidentRecordRefV1"
        },
        "deployment_binding_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        },
        "deployment_runtime_authority_ref": {
          "$ref": "#/$defs/ResidentRecordRefV1"
        },
        "deployment_runtime_authority_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        }
      },
      "required": [
        "deployment_runtime_authority_ref",
        "deployment_runtime_authority_sha256",
        "deployment_binding_ref",
        "deployment_binding_sha256",
        "checked_principal_trust_checkpoint_ref",
        "checked_principal_trust_checkpoint_sha256"
      ],
      "type": "object"
    },
    "OwnerComponentIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "OwnerSignerRecordSequenceV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "RequestBindingV1": {
      "additionalProperties": false,
      "dependentRequired": {
        "execution_owner_fence_ref": [
          "execution_owner_fence_sha256"
        ],
        "execution_owner_fence_sha256": [
          "execution_owner_fence_ref"
        ],
        "federation_request_admission_ref": [
          "federation_request_admission_sha256"
        ],
        "federation_request_admission_sha256": [
          "federation_request_admission_ref"
        ]
      },
      "properties": {
        "canonical_request_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        },
        "capability_id": {
          "$ref": "#/$defs/CapabilityIdV1"
        },
        "contract_set_ref": {
          "$ref": "#/$defs/ResidentRecordRefV1"
        },
        "contract_set_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        },
        "correlation_id": {
          "$ref": "#/$defs/ResidentCorrelationIdV1"
        },
        "deployment_binding_ref": {
          "$ref": "#/$defs/ResidentRecordRefV1"
        },
        "deployment_binding_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        },
        "execution_owner_fence_ref": {
          "$ref": "#/$defs/ResidentRecordRefV1"
        },
        "execution_owner_fence_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        },
        "federation_request_admission_ref": {
          "$ref": "#/$defs/ResidentRecordRefV1"
        },
        "federation_request_admission_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        },
        "request_id": {
          "$ref": "#/$defs/ResidentRequestIdV1"
        },
        "route_binding_ref": {
          "$ref": "#/$defs/ResidentRecordRefV1"
        },
        "route_binding_schema_id": {
          "$ref": "#/$defs/SchemaId"
        },
        "route_binding_schema_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        },
        "route_binding_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        },
        "route_generation": {
          "$ref": "#/$defs/RouteGenerationV1"
        },
        "session_grant_id": {
          "$ref": "#/$defs/SessionGrantIdV1"
        },
        "session_grant_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        }
      },
      "required": [
        "request_id",
        "correlation_id",
        "capability_id",
        "canonical_request_sha256",
        "session_grant_id",
        "session_grant_sha256",
        "deployment_binding_ref",
        "deployment_binding_sha256",
        "route_binding_schema_id",
        "route_binding_schema_sha256",
        "route_binding_ref",
        "route_binding_sha256",
        "route_generation",
        "contract_set_ref",
        "contract_set_sha256"
      ],
      "type": "object"
    },
    "ResidentCorrelationIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentKeyIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentPrincipalIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentRecordRefV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentRequestIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "RouteGenerationV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "SchemaId": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$",
      "type": "string"
    },
    "SessionGrantIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "SigningAuthorityBindingV1": {
      "additionalProperties": false,
      "oneOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "integrated_owner"
                ]
              },
              {
                "required": [
                  "standalone_owner_native"
                ]
              }
            ]
          },
          "properties": {
            "authority_mode": {
              "const": "integrated_runtime"
            }
          },
          "required": [
            "integrated_runtime"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "integrated_runtime"
                ]
              },
              {
                "required": [
                  "standalone_owner_native"
                ]
              }
            ]
          },
          "properties": {
            "authority_mode": {
              "const": "integrated_owner"
            }
          },
          "required": [
            "integrated_owner"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "integrated_runtime"
                ]
              },
              {
                "required": [
                  "integrated_owner"
                ]
              }
            ]
          },
          "properties": {
            "authority_mode": {
              "const": "standalone_owner_native"
            }
          },
          "required": [
            "standalone_owner_native"
          ]
        }
      ],
      "properties": {
        "authority_mode": {
          "$ref": "#/$defs/SigningAuthorityModeV1"
        },
        "integrated_owner": {
          "$ref": "#/$defs/IntegratedOwnerAuthorityV1"
        },
        "integrated_runtime": {
          "$ref": "#/$defs/IntegratedRuntimeAuthorityV1"
        },
        "principal_id": {
          "$ref": "#/$defs/ResidentPrincipalIdV1"
        },
        "signer_key_epoch": {
          "$ref": "#/$defs/SigningKeyEpochV1"
        },
        "signer_key_id": {
          "$ref": "#/$defs/ResidentKeyIdV1"
        },
        "standalone_owner_native": {
          "$ref": "#/$defs/StandaloneOwnerNativeAuthorityV1"
        }
      },
      "required": [
        "authority_mode",
        "principal_id",
        "signer_key_id",
        "signer_key_epoch"
      ],
      "type": "object"
    },
    "SigningAuthorityModeV1": {
      "oneOf": [
        {
          "const": "integrated_runtime",
          "type": "string"
        },
        {
          "const": "integrated_owner",
          "type": "string"
        },
        {
          "const": "standalone_owner_native",
          "type": "string"
        }
      ]
    },
    "SigningKeyEpochV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "StandaloneOwnerNativeAuthorityV1": {
      "additionalProperties": false,
      "properties": {
        "checked_owner_revocation_frontier_ref": {
          "$ref": "#/$defs/ResidentRecordRefV1"
        },
        "checked_owner_revocation_frontier_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        },
        "owner_authority_ref": {
          "$ref": "#/$defs/ResidentRecordRefV1"
        },
        "owner_authority_schema_id": {
          "$ref": "#/$defs/SchemaId"
        },
        "owner_authority_schema_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        },
        "owner_authority_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        },
        "owner_component_id": {
          "$ref": "#/$defs/OwnerComponentIdV1"
        },
        "owner_contract_manifest_ref": {
          "$ref": "#/$defs/ResidentRecordRefV1"
        },
        "owner_contract_manifest_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        }
      },
      "required": [
        "owner_component_id",
        "owner_authority_schema_id",
        "owner_authority_schema_sha256",
        "owner_authority_ref",
        "owner_authority_sha256",
        "owner_contract_manifest_ref",
        "owner_contract_manifest_sha256",
        "checked_owner_revocation_frontier_ref",
        "checked_owner_revocation_frontier_sha256"
      ],
      "type": "object"
    },
    "UnixTimeV1": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "$id": "https://www.rawthoughts.in/pale/schemas/capability-result.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {
      "not": {
        "required": [
          "failure"
        ]
      },
      "properties": {
        "status": {
          "const": "succeeded"
        }
      },
      "required": [
        "success"
      ]
    },
    {
      "not": {
        "required": [
          "success"
        ]
      },
      "properties": {
        "status": {
          "const": "failed"
        }
      },
      "required": [
        "failure"
      ]
    }
  ],
  "properties": {
    "attempt_id": {
      "$ref": "#/$defs/CapabilityAttemptIdV1"
    },
    "canonical_result_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "completed_at": {
      "$ref": "#/$defs/UnixTimeV1"
    },
    "failure": {
      "$ref": "#/$defs/CapabilityFailureV1"
    },
    "implementation_kind": {
      "$ref": "#/$defs/BoundedResidentTextV1"
    },
    "implementation_version": {
      "$ref": "#/$defs/BoundedResidentTextV1"
    },
    "issuer_key_epoch": {
      "$ref": "#/$defs/SigningKeyEpochV1"
    },
    "issuer_key_id": {
      "$ref": "#/$defs/ResidentKeyIdV1"
    },
    "issuer_principal_id": {
      "$ref": "#/$defs/ResidentPrincipalIdV1"
    },
    "request_binding": {
      "$ref": "#/$defs/RequestBindingV1"
    },
    "schema_id": {
      "$ref": "#/$defs/SchemaId",
      "const": "pale/capability-result.v1"
    },
    "schema_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "signature": {
      "$ref": "#/$defs/CanonicalSignatureV1"
    },
    "signing_authority_binding": {
      "$ref": "#/$defs/SigningAuthorityBindingV1"
    },
    "started_at": {
      "$ref": "#/$defs/UnixTimeV1"
    },
    "status": {
      "$ref": "#/$defs/CapabilityResultStatusV1"
    },
    "success": {
      "$ref": "#/$defs/CapabilitySuccessV1"
    }
  },
  "required": [
    "schema_id",
    "schema_sha256",
    "request_binding",
    "attempt_id",
    "status",
    "implementation_kind",
    "implementation_version",
    "started_at",
    "completed_at",
    "signing_authority_binding",
    "issuer_principal_id",
    "issuer_key_id",
    "issuer_key_epoch",
    "canonical_result_sha256",
    "signature"
  ],
  "title": "capability-result.v1",
  "type": "object"
}
