<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi>L</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>=</mo><mi mathvariant="normal">u64be</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi mathvariant="normal">∣</mi><mi>x</mi><mi mathvariant="normal">∣</mi><mo stretchy="false">)</mo><mo mathvariant="normal" lspace="0.22em" rspace="0.22em">∥</mo><mi>x</mi><mo separator="true">,</mo><mspace width="2em"/><mi>p</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>=</mo><mtext mathvariant="monospace">p-</mtext><mo mathvariant="normal" lspace="0.22em" rspace="0.22em">∥</mo><mi mathvariant="normal">hex</mi><mo>⁡</mo><mtext> ⁣</mtext><mrow><mo fence="true">(</mo><mi>H</mi><mo stretchy="false">(</mo><msub><mi>D</mi><mi>p</mi></msub><mo mathvariant="normal" lspace="0.22em" rspace="0.22em">∥</mo><mi>x</mi><mo stretchy="false">)</mo><mo fence="true">)</mo></mrow><mo separator="true">,</mo><mspace width="2em"/><mi>w</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>=</mo><mtext mathvariant="monospace">w-</mtext><mo mathvariant="normal" lspace="0.22em" rspace="0.22em">∥</mo><mi mathvariant="normal">hex</mi><mo>⁡</mo><mtext> ⁣</mtext><mrow><mo fence="true">(</mo><mi>H</mi><mo stretchy="false">(</mo><msub><mi>D</mi><mi>w</mi></msub><mo mathvariant="normal" lspace="0.22em" rspace="0.22em">∥</mo><mi>x</mi><mo stretchy="false">)</mo><mo fence="true">)</mo></mrow><mo separator="true">,</mo><mspace width="2em"/><mi>b</mi><mo stretchy="false">(</mo><mi>r</mi><mo separator="true">,</mo><mi>h</mi><mo stretchy="false">)</mo><mo>=</mo><mtext mathvariant="monospace">b-</mtext><mo mathvariant="normal" lspace="0.22em" rspace="0.22em">∥</mo><mi mathvariant="normal">hex</mi><mo>⁡</mo><mtext> ⁣</mtext><mrow><mo fence="true">(</mo><mi>H</mi><mo stretchy="false">(</mo><msub><mi>D</mi><mi>b</mi></msub><mo mathvariant="normal" lspace="0.22em" rspace="0.22em">∥</mo><mi>L</mi><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo><mo mathvariant="normal" lspace="0.22em" rspace="0.22em">∥</mo><mi>L</mi><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo fence="true">)</mo></mrow><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">L(x)=&#92;operatorname{u64be}(|x|)&#92;mathbin{&#92;Vert}x,&#92;qquad p(x)=&#92;texttt{p-}&#92;mathbin{&#92;Vert}&#92;operatorname{hex}&#92;!&#92;left(H(D&#95;p&#92;mathbin{&#92;Vert}x)&#92;right),&#92;qquad w(x)=&#92;texttt{w-}&#92;mathbin{&#92;Vert}&#92;operatorname{hex}&#92;!&#92;left(H(D&#95;w&#92;mathbin{&#92;Vert}x)&#92;right),&#92;qquad b(r,h)=&#92;texttt{b-}&#92;mathbin{&#92;Vert}&#92;operatorname{hex}&#92;!&#92;left(H(D&#95;b&#92;mathbin{&#92;Vert}L(r)&#92;mathbin{&#92;Vert}L(h))&#92;right).</annotation></semantics></math>
