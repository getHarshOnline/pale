{
  "$defs": {
    "CanonicalSignatureV1": {
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$",
      "type": "string"
    },
    "CheckpointDomainPrefixV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "CheckpointSignerEpochV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "CheckpointSigningAuthorityIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "CheckpointSigningScopeV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "bootstrap_id": {
              "$ref": "#/$defs/PrincipalBootstrapIdV1"
            },
            "kind": {
              "const": "principal_trust_store",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "bootstrap_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "deployment_binding_ref": {
              "$ref": "#/$defs/ResidentRecordRefV1"
            },
            "deployment_binding_sha256": {
              "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
            },
            "kind": {
              "const": "deployment",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "deployment_binding_ref",
            "deployment_binding_sha256"
          ],
          "type": "object"
        }
      ]
    },
    "ControlIncarnationIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ControlStoreIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "Ed25519PublicKeyV1": {
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
      "type": "string"
    },
    "PrincipalAuthorityStateV1": {
      "oneOf": [
        {
          "const": "active",
          "type": "string"
        },
        {
          "const": "retired",
          "type": "string"
        }
      ]
    },
    "PrincipalBootstrapIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "PrincipalKeyEpochV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "ResidentKeyIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentPrincipalIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentRecordRefV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "SchemaId": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$",
      "type": "string"
    },
    "SigningKeyEpochV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "UnixTimeV1": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "$id": "https://www.rawthoughts.in/pale/schemas/checkpoint-signing-authority.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_domain_prefixes": {
      "items": {
        "$ref": "#/$defs/CheckpointDomainPrefixV1"
      },
      "type": "array"
    },
    "canonical_checkpoint_signing_authority_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "checkpoint_profile_ref": {
      "$ref": "#/$defs/ResidentRecordRefV1"
    },
    "checkpoint_profile_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "checkpoint_signing_authority_id": {
      "$ref": "#/$defs/CheckpointSigningAuthorityIdV1"
    },
    "control_incarnation_id": {
      "$ref": "#/$defs/ControlIncarnationIdV1"
    },
    "control_store_id": {
      "$ref": "#/$defs/ControlStoreIdV1"
    },
    "expires_at": {
      "$ref": "#/$defs/UnixTimeV1"
    },
    "issued_at": {
      "$ref": "#/$defs/UnixTimeV1"
    },
    "issuer_key_epoch": {
      "$ref": "#/$defs/PrincipalKeyEpochV1"
    },
    "issuer_key_id": {
      "$ref": "#/$defs/ResidentKeyIdV1"
    },
    "issuer_principal_id": {
      "$ref": "#/$defs/ResidentPrincipalIdV1"
    },
    "previous_authority_ref": {
      "$ref": "#/$defs/ResidentRecordRefV1"
    },
    "previous_authority_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "principal_id": {
      "$ref": "#/$defs/ResidentPrincipalIdV1"
    },
    "schema_id": {
      "$ref": "#/$defs/SchemaId",
      "const": "pale/checkpoint-signing-authority.v1"
    },
    "schema_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "scope": {
      "$ref": "#/$defs/CheckpointSigningScopeV1"
    },
    "signature": {
      "$ref": "#/$defs/CanonicalSignatureV1"
    },
    "signer_epoch": {
      "$ref": "#/$defs/CheckpointSignerEpochV1"
    },
    "state": {
      "$ref": "#/$defs/PrincipalAuthorityStateV1"
    },
    "subject_key_epoch": {
      "$ref": "#/$defs/SigningKeyEpochV1"
    },
    "subject_key_id": {
      "$ref": "#/$defs/ResidentKeyIdV1"
    },
    "subject_public_key": {
      "$ref": "#/$defs/Ed25519PublicKeyV1"
    }
  },
  "required": [
    "schema_id",
    "schema_sha256",
    "checkpoint_signing_authority_id",
    "principal_id",
    "control_store_id",
    "control_incarnation_id",
    "scope",
    "checkpoint_profile_ref",
    "checkpoint_profile_sha256",
    "allowed_domain_prefixes",
    "subject_key_id",
    "subject_key_epoch",
    "subject_public_key",
    "signer_epoch",
    "state",
    "issued_at",
    "expires_at",
    "issuer_principal_id",
    "issuer_key_id",
    "issuer_key_epoch",
    "canonical_checkpoint_signing_authority_sha256",
    "signature"
  ],
  "title": "checkpoint-signing-authority.v1",
  "type": "object"
}
