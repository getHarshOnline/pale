<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi mathvariant="normal">valid</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>e</mi><mo separator="true">,</mo><mi>n</mi><mo stretchy="false">)</mo><mo>⟺</mo><mo fence="true" stretchy="true" minsize="1.2em" maxsize="1.2em">(</mo><mi>e</mi><mo>=</mo><mi mathvariant="normal">∅</mi><mo>∧</mo><mi mathvariant="normal">position</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo><mo>=</mo><mn>1</mn><mo fence="true" stretchy="true" minsize="1.2em" maxsize="1.2em">)</mo><mo>∨</mo><mo fence="true" stretchy="true" minsize="1.2em" maxsize="1.2em">(</mo><mi>e</mi><mo mathvariant="normal">≠</mo><mi mathvariant="normal">∅</mi><mo>∧</mo><mi mathvariant="normal">key</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo><mo>=</mo><mi mathvariant="normal">key</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo><mo>∧</mo><mi mathvariant="normal">position</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo><mo>=</mo><mi mathvariant="normal">position</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo><mo>+</mo><mn>1</mn><mo fence="true" stretchy="true" minsize="1.2em" maxsize="1.2em">)</mo></mrow><annotation encoding="application/x-tex">&#92;operatorname{valid}(e,n) &#92;Longleftrightarrow &#92;bigl(e=&#92;varnothing &#92;land &#92;operatorname{position}(n)=1&#92;bigr) &#92;lor &#92;bigl(e&#92;neq&#92;varnothing &#92;land &#92;operatorname{key}(e)=&#92;operatorname{key}(n) &#92;land &#92;operatorname{position}(n)=&#92;operatorname{position}(e)+1&#92;bigr)</annotation></semantics></math>
