  "required": [
    "schema_id",
    "schema_sha256",
    "writer_fence_id",
    "principal_id",
    "writer_generation",
    "primary_node_id",
    "process_instance_id",
    "boot_incarnation_id",
    "trust_store_id",
    "trust_store_incarnation_id",
    "opened_deployment_store_heads_root_sha256",
    "principal_session_floor_epoch",
    "state",
    "acquired_at",
    "issuer_principal_id",
    "issuer_key_id",
    "issuer_key_epoch",
    "canonical_principal_resident_writer_fence_sha256",
    "signature"
  ],
  "title": "principal-resident-writer-fence.v1",
  "type": "object"
}
