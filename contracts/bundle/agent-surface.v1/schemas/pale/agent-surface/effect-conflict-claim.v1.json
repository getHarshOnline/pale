{
  "$defs": {
    "ActionIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "BusinessIdempotencyKeyV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "CanonicalSignatureV1": {
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$",
      "type": "string"
    },
    "EffectConflictClaimGenerationV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "EffectConflictClaimIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "EffectConflictClaimStateV1": {
      "oneOf": [
        {
          "const": "active",
          "type": "string"
        },
        {
          "const": "released",
          "type": "string"
        },
        {
          "const": "transferred",
          "type": "string"
        }
      ]
    },
    "EffectConflictTerminalReasonV1": {
      "oneOf": [
        {
          "const": "confirmed",
          "type": "string"
        },
        {
          "const": "not_applied",
          "type": "string"
        },
        {
          "const": "cancelled_before_dispatch",
          "type": "string"
        },
        {
          "const": "reconciliation_custody",
          "type": "string"
        }
      ]
    },
    "RelationshipScopeV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentControllerIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentKeyIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentPrincipalIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentRecordRefV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentRequestIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "SchemaId": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$",
      "type": "string"
    },
    "SigningKeyEpochV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "UnixTimeV1": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "$id": "https://www.rawthoughts.in/pale/schemas/effect-conflict-claim.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
