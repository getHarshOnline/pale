<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><msup><mi mathvariant="script">R</mi><mo lspace="0em" rspace="0em">−</mo></msup><mo stretchy="false">(</mo><msub><mi>S</mi><mn>0</mn></msub><mo stretchy="false">)</mo><mo>=</mo><mi>μ</mi><mi>X</mi><mi mathvariant="normal">.</mi><mrow><mo fence="true">(</mo><msub><mi>S</mi><mn>0</mn></msub><mo>∪</mo><mo stretchy="false">{</mo><mi>u</mi><mo>∈</mo><mi>V</mi><mo>∣</mo><mi mathvariant="normal">∃</mi><mi>v</mi><mo>∈</mo><mi>X</mi><mo>:</mo><mo stretchy="false">(</mo><mi>u</mi><mo separator="true">,</mo><mi>v</mi><mo stretchy="false">)</mo><mo>∈</mo><mi>E</mi><mo stretchy="false">}</mo><mo fence="true">)</mo></mrow><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">&#92;mathcal{R}^{-}(S&#95;0)=&#92;mu X.&#92;left(S&#95;0&#92;cup&#92;{u&#92;in V&#92;mid&#92;exists v&#92;in X:(u,v)&#92;in E&#92;}&#92;right).</annotation></semantics></math>
