<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi mathvariant="normal">apply</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>S</mi><mi>r</mi></msub><mo separator="true">,</mo><msub><mi>D</mi><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo>=</mo><msub><mi>S</mi><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></msub><mtext>  </mtext><mo>⟺</mo><mtext>  </mtext><mstyle scriptlevel="1"><mtable rowspacing="0.1em" columnalign="center" columnspacing="1em"><mtr><mtd><mstyle scriptlevel="1" displaystyle="false"><mrow><mi mathvariant="normal">generation</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>S</mi><mi>r</mi></msub><mo stretchy="false">)</mo><mo>=</mo><mi mathvariant="normal">generation</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>D</mi><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mstyle></mtd></mtr><mtr><mtd><mstyle scriptlevel="1" displaystyle="false"><mrow><mi mathvariant="normal">from</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>D</mi><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo>=</mo><mi>r</mi><mspace width="0.3253em"/><mo>∧</mo><mspace width="0.3253em"/><mi mathvariant="normal">to</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>D</mi><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo>=</mo><mi>r</mi><mo>+</mo><mn>1</mn></mrow></mstyle></mtd></mtr></mtable></mstyle><mo separator="true">;</mo><mspace width="2em"/><mtext>generation mismatch</mtext><mtext>  </mtext><mo>∨</mo><mtext>  </mtext><mtext>revision gap</mtext><mo>⟹</mo><mi mathvariant="normal">resynchronize</mi><mo>⁡</mo></mrow><annotation encoding="application/x-tex">&#92;operatorname{apply}(S&#95;r,D&#95;{r+1})=S&#95;{r+1}&#92;iff&#92;substack{&#92;operatorname{generation}(S&#95;r)=&#92;operatorname{generation}(D&#95;{r+1})&#92;&#92;&#92;operatorname{from}(D&#95;{r+1})=r&#92;;&#92;land&#92;;&#92;operatorname{to}(D&#95;{r+1})=r+1};&#92;qquad&#92;text{generation mismatch}&#92;;&#92;lor&#92;;&#92;text{revision gap}&#92;Longrightarrow&#92;operatorname{resynchronize}</annotation></semantics></math>
