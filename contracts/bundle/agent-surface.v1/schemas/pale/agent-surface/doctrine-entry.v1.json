{
  "$defs": {
    "DoctrineCatalog": {
      "additionalProperties": false,
      "properties": {
        "entry": {
          "items": {
            "$ref": "#/$defs/DoctrineEntry"
          },
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "entry"
      ],
      "type": "object"
    },
    "DoctrineEntry": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "doctrine": {
          "$ref": "#/$defs/OwnedConfinedRelativePath"
        },
        "extends": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PackageResourceLinkV1"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/PackageResourceIdV1"
        },
        "official_sources": {
          "default": [],
          "items": {
            "$ref": "https://www.rawthoughts.in/pale/schemas/official-reference.v1.json"
          },
          "type": "array"
        },
        "placement": {
          "$ref": "#/$defs/DoctrinePlacement"
        },
        "requires": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PackageResourceLinkV1"
          },
          "type": "array"
        },
        "see_also": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PackageResourceLinkV1"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "description",
        "doctrine",
        "placement"
      ],
      "type": "object"
    },
    "DoctrinePlacement": {
      "oneOf": [
        {
          "const": "standalone_judgment",
          "type": "string"
        },
        {
          "const": "operation_procedure",
          "type": "string"
        },
        {
          "const": "startup_policy",
          "type": "string"
        }
      ]
    },
    "OwnedConfinedRelativePath": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "PackageIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "PackageResourceIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:[./][a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "PackageResourceLinkV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "resource_id": {
              "$ref": "#/$defs/PackageResourceIdV1"
            },
            "scope": {
              "const": "local",
              "type": "string"
            }
          },
          "required": [
            "scope",
            "resource_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "resource": {
              "$ref": "#/$defs/PackageResourceRefV1"
            },
            "scope": {
              "const": "external",
              "type": "string"
            }
          },
          "required": [
            "scope",
            "resource"
          ],
          "type": "object"
        }
      ]
    },
    "PackageResourceRefV1": {
      "additionalProperties": false,
      "properties": {
        "package_id": {
          "$ref": "#/$defs/PackageIdV1"
        },
        "resource_id": {
          "$ref": "#/$defs/PackageResourceIdV1"
        }
      },
      "required": [
        "package_id",
        "resource_id"
      ],
      "type": "object"
    }
  },
  "$id": "https://www.rawthoughts.in/pale/schemas/doctrine-entry.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "doctrine": {
      "$ref": "#/$defs/DoctrineCatalog"
    }
  },
  "required": [
    "doctrine"
  ],
  "title": "doctrine-entry.v1",
  "type": "object"
}
