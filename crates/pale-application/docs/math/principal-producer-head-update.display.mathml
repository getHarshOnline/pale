<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi mathvariant="normal">key</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>H</mi><mi>i</mi></msub><mo stretchy="false">)</mo><mo>&lt;</mo><mi mathvariant="normal">key</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>H</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><msup><mi>H</mi><mo mathvariant="normal" lspace="0em" rspace="0em">′</mo></msup><mo>=</mo><mi mathvariant="normal">update</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>H</mi><mo separator="true">,</mo><mi mathvariant="normal">producer</mi><mo>⁡</mo><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">root</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo><mo>=</mo><mi mathvariant="normal">headRoot</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">root</mi><mo>⁡</mo><mo stretchy="false">(</mo><msup><mi>H</mi><mo mathvariant="normal" lspace="0em" rspace="0em">′</mo></msup><mo stretchy="false">)</mo><mo>=</mo><mi mathvariant="normal">headRoot</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">(</mo><mi>n</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">&#92;operatorname{key}(H&#95;i)&lt;&#92;operatorname{key}(H&#95;{i+1}),&#92;qquad H^{&#92;prime}=&#92;operatorname{update}(H,&#92;operatorname{producer}),&#92;qquad &#92;operatorname{root}(H)=&#92;operatorname{headRoot}(C(n)),&#92;qquad &#92;operatorname{root}(H^{&#92;prime})=&#92;operatorname{headRoot}(C(n+1)).</annotation></semantics></math>
