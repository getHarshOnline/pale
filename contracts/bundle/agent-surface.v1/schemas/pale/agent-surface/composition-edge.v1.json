        },
        {
          "const": "read",
          "type": "string"
        },
        {
          "const": "execute",
          "type": "string"
        },
        {
          "const": "write",
          "type": "string"
        },
        {
          "const": "network",
          "type": "string"
        },
        {
          "const": "publish",
          "type": "string"
        }
      ]
    }
  },
