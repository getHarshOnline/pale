<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi mathvariant="normal">succeeded</mi><mo>⁡</mo><mtext>  </mtext><mo>⟺</mo><mtext>  </mtext><mi>S</mi><mo>∧</mo><mi mathvariant="normal">¬</mi><mi>F</mi><mo>∧</mo><mo stretchy="false">(</mo><mi>I</mi><mo>⊕</mo><mi>M</mi><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">failed</mi><mo>⁡</mo><mtext>  </mtext><mo>⟺</mo><mtext>  </mtext><mi>F</mi><mo>∧</mo><mi mathvariant="normal">¬</mi><mi>S</mi><mo>∧</mo><mi mathvariant="normal">¬</mi><mi>I</mi><mo>∧</mo><mi mathvariant="normal">¬</mi><mi>M</mi><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">&#92;operatorname{succeeded}&#92;iff S&#92;land&#92;neg F&#92;land(I&#92;oplus M),&#92;qquad &#92;operatorname{failed}&#92;iff F&#92;land&#92;neg S&#92;land&#92;neg I&#92;land&#92;neg M.</annotation></semantics></math>
