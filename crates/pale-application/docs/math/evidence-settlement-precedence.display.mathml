al">e</mi><mi mathvariant="normal">r</mi></mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo separator="true">,</mo><mrow><mi mathvariant="normal">o</mi><mi mathvariant="normal">w</mi><mi mathvariant="normal">n</mi><mi mathvariant="normal">e</mi><mi mathvariant="normal">r</mi></mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo separator="true">,</mo><mrow><mi mathvariant="normal">n</mi><mi mathvariant="normal">a</mi><mi mathvariant="normal">t</mi><mi mathvariant="normal">i</mi><mi mathvariant="normal">v</mi><mi mathvariant="normal">e</mi></mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo fence="true">)</mo></mrow><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">&#92;operatorname{settle}(o,t)=&#92;operatorname{first}&#92;!&#92;left(&#92;mathrm{conflict},&#92;mathrm{invalidation},&#92;mathrm{expiry},&#92;bigwedge&#95;{&#92;ell&#92;in L(t)}F&#95;&#92;ell,&#92;bigwedge&#95;{d&#92;in&#92;{R,I,G,C&#92;}}D&#95;d,&#92;mathrm{provider}(t),&#92;mathrm{owner}(t),&#92;mathrm{native}(t)&#92;right).</annotation></semantics></math>
