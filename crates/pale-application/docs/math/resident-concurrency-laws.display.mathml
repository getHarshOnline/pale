<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mrow><mo fence="true">∣</mo><mi>C</mi><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo><mo fence="true">∣</mo></mrow><mo>≤</mo><mn>1</mn><mo separator="true">,</mo><mspace width="2em"/><msub><mi>q</mi><mi>c</mi></msub><mo>≤</mo><msub><mi>L</mi><mi>c</mi></msub><mo separator="true">,</mo><mspace width="1em"/><msub><mi>q</mi><mi>w</mi></msub><mo>≤</mo><msub><mi>L</mi><mi>w</mi></msub><mo separator="true">,</mo><mspace width="1em"/><mi>q</mi><mo>≤</mo><mi>L</mi><mo separator="true">,</mo><mspace width="1em"/><mi>p</mi><mo>≤</mo><mi>P</mi><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">&#92;left|C(d)&#92;right|&#92;leq 1,&#92;qquad q&#95;c&#92;leq L&#95;c,&#92;quad q&#95;w&#92;leq L&#95;w,&#92;quad q&#92;leq L,&#92;quad p&#92;leq P.</annotation></semantics></math>
