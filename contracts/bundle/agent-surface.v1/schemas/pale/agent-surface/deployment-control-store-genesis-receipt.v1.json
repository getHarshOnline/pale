{
  "$defs": {
    "CanonicalSignatureV1": {
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$",
      "type": "string"
    },
    "ControlCheckpointDomainIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ControlDomainEpochV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "ControlDomainSequenceV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "ControlIncarnationIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ControlStoreIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "DeploymentControlStoreGenesisIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "PrincipalBootstrapInitialControlCheckpointV1": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_domain_id": {
          "$ref": "#/$defs/ControlCheckpointDomainIdV1"
        },
        "control_checkpoint_ref": {
          "$ref": "#/$defs/ResidentRecordRefV1"
        },
        "control_checkpoint_sha256": {
          "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
        },
        "domain_epoch": {
          "$ref": "#/$defs/ControlDomainEpochV1"
        },
        "domain_sequence": {
          "$ref": "#/$defs/ControlDomainSequenceV1"
        }
      },
      "required": [
        "checkpoint_domain_id",
        "domain_epoch",
        "domain_sequence",
        "control_checkpoint_ref",
        "control_checkpoint_sha256"
      ],
      "type": "object"
    },
    "ResidentKeyIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentPrincipalIdV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ResidentRecordRefV1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "SchemaId": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$",
      "type": "string"
    },
    "SigningKeyEpochV1": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "UnixTimeV1": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "WorkspaceId": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:[.:/][a-z][a-z0-9_-]*)*$",
      "type": "string"
    }
  },
  "$id": "https://www.rawthoughts.in/pale/schemas/deployment-control-store-genesis-receipt.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_deployment_control_store_genesis_receipt_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "checkpoint_signing_authority_ref": {
      "$ref": "#/$defs/ResidentRecordRefV1"
    },
    "checkpoint_signing_authority_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "committed_at": {
      "$ref": "#/$defs/UnixTimeV1"
    },
    "control_incarnation_id": {
      "$ref": "#/$defs/ControlIncarnationIdV1"
    },
    "control_store_id": {
      "$ref": "#/$defs/ControlStoreIdV1"
    },
    "deployment_binding_ref": {
      "$ref": "#/$defs/ResidentRecordRefV1"
    },
    "deployment_binding_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "deployment_runtime_authority_ref": {
      "$ref": "#/$defs/ResidentRecordRefV1"
    },
    "deployment_runtime_authority_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "genesis_id": {
      "$ref": "#/$defs/DeploymentControlStoreGenesisIdV1"
    },
    "initial_control_checkpoints": {
      "items": {
        "$ref": "#/$defs/PrincipalBootstrapInitialControlCheckpointV1"
      },
      "type": "array"
    },
    "issuer_key_epoch": {
      "$ref": "#/$defs/SigningKeyEpochV1"
    },
    "issuer_key_id": {
      "$ref": "#/$defs/ResidentKeyIdV1"
    },
    "issuer_principal_id": {
      "$ref": "#/$defs/ResidentPrincipalIdV1"
    },
    "principal_id": {
      "$ref": "#/$defs/ResidentPrincipalIdV1"
    },
    "schema_id": {
      "$ref": "#/$defs/SchemaId",
      "const": "pale/deployment-control-store-genesis-receipt.v1"
    },
    "schema_sha256": {
      "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
    },
    "signature": {
      "$ref": "#/$defs/CanonicalSignatureV1"
    },
    "workspace_id": {
      "$ref": "#/$defs/WorkspaceId"
    }
  },
  "required": [
    "schema_id",
    "schema_sha256",
    "genesis_id",
    "principal_id",
    "workspace_id",
    "deployment_binding_ref",
    "deployment_binding_sha256",
    "control_store_id",
    "control_incarnation_id",
    "checkpoint_signing_authority_ref",
    "checkpoint_signing_authority_sha256",
    "initial_control_checkpoints",
    "committed_at",
    "deployment_runtime_authority_ref",
    "deployment_runtime_authority_sha256",
    "issuer_principal_id",
    "issuer_key_id",
    "issuer_key_epoch",
    "canonical_deployment_control_store_genesis_receipt_sha256",
    "signature"
  ],
  "title": "deployment-control-store-genesis-receipt.v1",
  "type": "object"
}
