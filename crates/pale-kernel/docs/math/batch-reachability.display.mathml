<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><msub><mi mathvariant="script">R</mi><mi>d</mi></msub><mo stretchy="false">(</mo><msub><mi>S</mi><mi>i</mi></msub><mo stretchy="false">)</mo><mo>=</mo><mi>μ</mi><mi>X</mi><mi mathvariant="normal">.</mi><mrow><mo fence="true">(</mo><msub><mi>S</mi><mi>i</mi></msub><mo>∪</mo><mrow><mo fence="true">{</mo><mi>v</mi><mo>∈</mo><mi>V</mi><mtext>  </mtext><mo fence="true" lspace="0.05em" rspace="0.05em">|</mo><mtext>  </mtext><mi mathvariant="normal">∃</mi><mi>u</mi><mo>∈</mo><mi>X</mi><mo>:</mo><mo stretchy="false">(</mo><mi>u</mi><mo separator="true">,</mo><mi>v</mi><mo stretchy="false">)</mo><mo>∈</mo><msub><mi>E</mi><mi>d</mi></msub><mo fence="true">}</mo></mrow><mo fence="true">)</mo></mrow><mo separator="true">,</mo><mspace width="2em"/><mi>i</mi><mo>∈</mo><mo stretchy="false">{</mo><mn>1</mn><mo separator="true">,</mo><mo>…</mo><mo separator="true">,</mo><mi>b</mi><mo stretchy="false">}</mo><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">&#92;mathcal{R}&#95;{d}(S&#95;i) = &#92;mu X.&#92;left(S&#95;i &#92;cup &#92;left&#92;{v &#92;in V &#92;;&#92;middle|&#92;; &#92;exists u &#92;in X : (u,v) &#92;in E&#95;d&#92;right&#92;}&#92;right), &#92;qquad i &#92;in &#92;{1,&#92;ldots,b&#92;}.</annotation></semantics></math>
