<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi mathvariant="normal">expectedHead</mi><mo>⁡</mo><mo>=</mo><mi mathvariant="normal">∅</mi><mo>⟹</mo><mi mathvariant="normal">sequence</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo stretchy="false">)</mo><mo>=</mo><mn>1</mn><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">expectedHead</mi><mo>⁡</mo><mo>=</mo><mi>j</mi><mo>⟹</mo><mi mathvariant="normal">sequence</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>e</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo>=</mo><mi>j</mi><mo>+</mo><mn>1.</mn></mrow><annotation encoding="application/x-tex">&#92;operatorname{expectedHead}=&#92;varnothing&#92;Longrightarrow&#92;operatorname{sequence}(e&#95;1)=1,&#92;qquad &#92;operatorname{expectedHead}=j&#92;Longrightarrow&#92;operatorname{sequence}(e&#95;{j+1})=j+1.</annotation></semantics></math>
