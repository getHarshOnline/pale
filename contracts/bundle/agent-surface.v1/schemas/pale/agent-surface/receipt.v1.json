            "post_sha256": {
              "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
            },
            "pre_sha256": {
              "$ref": "https://www.rawthoughts.in/pale/schemas/sha256-digest.v1.json"
            }
          },
          "required": [
            "action",
            "pre_sha256",
            "post_sha256"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "update",
