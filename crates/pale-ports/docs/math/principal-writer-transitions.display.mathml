<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi mathvariant="normal">∅</mi><mo>→</mo><msub><mi>A</mi><mn>1</mn></msub><mo separator="true">,</mo><mspace width="2em"/><msub><mi>A</mi><mi>g</mi></msub><mo>→</mo><msub><mi>R</mi><mi>g</mi></msub><mo separator="true">,</mo><mspace width="2em"/><msub><mi>R</mi><mi>g</mi></msub><mo>→</mo><msub><mi>A</mi><mrow><mi>g</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">&#92;varnothing &#92;to A&#95;1,&#92;qquad A&#95;g &#92;to R&#95;g,&#92;qquad R&#95;g &#92;to A&#95;{g+1}</annotation></semantics></math>
