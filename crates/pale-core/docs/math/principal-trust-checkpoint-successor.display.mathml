<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><msup><mi>e</mi><mo mathvariant="normal" lspace="0em" rspace="0em">′</mo></msup><mo>=</mo><mi>e</mi><mo>+</mo><mn>1</mn><mtext>  </mtext><mo>∧</mo><mtext>  </mtext><msup><mi>p</mi><mo mathvariant="normal" lspace="0em" rspace="0em">′</mo></msup><mo>=</mo><mi>p</mi><mtext>  </mtext><mo>∧</mo><mtext>  </mtext><msup><mi>s</mi><mo mathvariant="normal" lspace="0em" rspace="0em">′</mo></msup><mo>=</mo><mi>s</mi><mtext>  </mtext><mo>∧</mo><mtext>  </mtext><msup><mi>i</mi><mo mathvariant="normal" lspace="0em" rspace="0em">′</mo></msup><mo>=</mo><mi>i</mi><mtext>  </mtext><mo>∧</mo><mtext>  </mtext><msup><mi>r</mi><mo mathvariant="normal" lspace="0em" rspace="0em">′</mo></msup><mo>=</mo><mo stretchy="false">(</mo><mi mathvariant="normal">ref</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo><mo separator="true">,</mo><mi mathvariant="normal">hash</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mtext>  </mtext><mo>∧</mo><mtext>  </mtext><msup><mi>t</mi><mo mathvariant="normal" lspace="0em" rspace="0em">′</mo></msup><mo>≥</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">e^{&#92;prime}=e+1&#92;;&#92;land&#92;;p^{&#92;prime}=p&#92;;&#92;land&#92;;s^{&#92;prime}=s&#92;;&#92;land&#92;;i^{&#92;prime}=i&#92;;&#92;land&#92;;r^{&#92;prime}=(&#92;operatorname{ref}(C),&#92;operatorname{hash}(C))&#92;;&#92;land&#92;;t^{&#92;prime}&#92;ge t</annotation></semantics></math>
