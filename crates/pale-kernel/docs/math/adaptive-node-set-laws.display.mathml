∈</mo><mi>O</mi><mo stretchy="false">(</mo><mi mathvariant="normal">∣</mi><mi>S</mi><mi mathvariant="normal">∣</mi><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><msub><mi>T</mi><mrow><mi mathvariant="normal">i</mi><mi mathvariant="normal">t</mi><mi mathvariant="normal">e</mi><mi mathvariant="normal">r</mi><mi mathvariant="normal">a</mi><mi mathvariant="normal">t</mi><mi mathvariant="normal">e</mi></mrow></msub><mo stretchy="false">(</mo><msub><mi>S</mi><mrow><mi mathvariant="normal">d</mi><mi mathvariant="normal">e</mi><mi mathvariant="normal">n</mi><mi mathvariant="normal">s</mi><mi mathvariant="normal">e</mi></mrow></msub><mo stretchy="false">)</mo><mo>∈</mo><mi>O</mi><mo stretchy="false">(</mo><mi mathvariant="normal">∣</mi><mi>U</mi><mi mathvariant="normal">∣</mi><mi mathvariant="normal">/</mi><mn>64</mn><mo>+</mo><mi mathvariant="normal">∣</mi><mi>S</mi><mi mathvariant="normal">∣</mi><mo stretchy="false">)</mo><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">10{,}000|S|&#92;geq&#92;delta|U|,&#92;qquad &#92;operatorname{members}(P(S))=S,&#92;qquad A&#92;cap B&#92;subseteq A,&#92;qquad A&#92;cap B&#92;subseteq B,&#92;qquad A&#92;setminus B=&#92;{x&#92;in A&#92;mid x&#92;notin B&#92;},&#92;qquad U&#92;setminus S=&#92;operatorname{complement}&#95;U(S),&#92;qquad T&#95;{&#92;mathrm{iterate}}(S&#95;{&#92;mathrm{sorted/roaring}})&#92;in O(|S|),&#92;qquad T&#95;{&#92;mathrm{iterate}}(S&#95;{&#92;mathrm{dense}})&#92;in O(|U|/64+|S|).</annotation></semantics></math>
