<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi mathvariant="script">O</mi><mo stretchy="false">(</mo><mi>P</mi><mo stretchy="false">)</mo><mo>=</mo><msubsup><mrow><mo fence="true">⟨</mo><msub><mrow><mi mathvariant="normal">sort</mi><mo>⁡</mo></mrow><mrow><mi mathvariant="normal">s</mi><mi mathvariant="normal">u</mi><mi mathvariant="normal">b</mi><mi mathvariant="normal">j</mi><mi mathvariant="normal">e</mi><mi mathvariant="normal">c</mi><mi mathvariant="normal">t</mi></mrow></msub><mtext> ⁣</mtext><mrow><mo fence="true">(</mo><mi mathvariant="normal">close</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo><mo fence="true">)</mo></mrow><mo fence="true">⟩</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi mathvariant="normal">∣</mi><mi>P</mi><mi mathvariant="normal">∣</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">render</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo><mtext> is admitted only with </mtext><mi mathvariant="script">O</mi><mo stretchy="false">(</mo><mi>P</mi><msub><mo stretchy="false">)</mo><mi>i</mi></msub><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">&#92;mathcal{O}(P)=&#92;left&#92;langle&#92;operatorname{sort}&#95;{&#92;mathrm{subject}}&#92;!&#92;left(&#92;operatorname{close}(p&#95;i)&#92;right)&#92;right&#92;rangle&#95;{i=0}^{|P|-1},&#92;qquad &#92;operatorname{render}(p&#95;i)&#92;text{ is admitted only with }&#92;mathcal{O}(P)&#95;i.</annotation></semantics></math>
