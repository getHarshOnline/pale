<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi mathvariant="normal">pred</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>A</mi><mrow><mi>p</mi><mo separator="true">,</mo><mn>0</mn></mrow></msub><mo stretchy="false">)</mo><mo>=</mo><mi mathvariant="normal">⊥</mi><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">∀</mi><mi>i</mi><mo>&lt;</mo><mi>N</mi><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo><mo>:</mo><mtext> </mtext><mi mathvariant="normal">pred</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>A</mi><mrow><mi>p</mi><mo separator="true">,</mo><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo>=</mo><mi mathvariant="normal">coord</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>A</mi><mrow><mi>p</mi><mo separator="true">,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo><mo>∧</mo><msub><mi>R</mi><mrow><mi>p</mi><mo separator="true">,</mo><mi>i</mi></mrow></msub><mo mathvariant="normal">≠</mo><mi mathvariant="normal">⊥</mi><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">∣</mi><mi>E</mi><mi mathvariant="normal">∣</mi><mo>=</mo><munder><mo>∑</mo><mrow><mi>p</mi><mo>∈</mo><mi>P</mi></mrow></munder><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><mi mathvariant="normal">root</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo><mo>=</mo><mi mathvariant="normal">headRoot</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">&#92;operatorname{pred}(A&#95;{p,0})=&#92;bot,&#92;qquad &#92;forall i&lt;N(p):&#92; &#92;operatorname{pred}(A&#95;{p,i+1})=&#92;operatorname{coord}(A&#95;{p,i})&#92;land R&#95;{p,i}&#92;neq&#92;bot,&#92;qquad |E|=&#92;sum&#95;{p&#92;in P}(N(p)+1),&#92;qquad &#92;operatorname{root}(H)=&#92;operatorname{headRoot}(C).</annotation></semantics></math>
