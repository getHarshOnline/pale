<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><msub><mrow><mi mathvariant="normal">merge</mi><mo>⁡</mo></mrow><mi>N</mi></msub><mo stretchy="false">(</mo><mi>A</mi><mo separator="true">,</mo><mi>B</mi><mo stretchy="false">)</mo><mo>=</mo><msub><mrow><mi mathvariant="normal">smallest</mi><mo>⁡</mo></mrow><mi>N</mi></msub><mo stretchy="false">(</mo><mi>A</mi><mo lspace="0.22em" rspace="0.22em">⊎</mo><mi>B</mi><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><msub><mrow><mi mathvariant="normal">merge</mi><mo>⁡</mo></mrow><mi>N</mi></msub><mo stretchy="false">(</mo><mi>A</mi><mo separator="true">,</mo><mi mathvariant="normal">∅</mi><mo stretchy="false">)</mo><mo>=</mo><mi>A</mi><mo>=</mo><msub><mrow><mi mathvariant="normal">merge</mi><mo>⁡</mo></mrow><mi>N</mi></msub><mo stretchy="false">(</mo><mi mathvariant="normal">∅</mi><mo separator="true">,</mo><mi>A</mi><mo stretchy="false">)</mo><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">&#92;operatorname{merge}&#95;{N}(A,B)=&#92;operatorname{smallest}&#95;{N}(A&#92;mathbin{&#92;uplus}B),&#92;qquad &#92;operatorname{merge}&#95;{N}(A,&#92;varnothing)=A=&#92;operatorname{merge}&#95;{N}(&#92;varnothing,A).</annotation></semantics></math>
