<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><msub><mi>X</mi><mn>0</mn></msub><mo>=</mo><mi>S</mi><mo separator="true">,</mo><mspace width="2em"/><msub><mi>X</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><msub><mi>X</mi><mi>n</mi></msub><mo>∪</mo><mrow><mo fence="true">{</mo><mi>v</mi><mo>∣</mo><mi mathvariant="normal">∃</mi><mi>u</mi><mo>∈</mo><msub><mi>X</mi><mi>n</mi></msub><mo>:</mo><mo stretchy="false">(</mo><mi>u</mi><mo separator="true">,</mo><mi>v</mi><mo stretchy="false">)</mo><mo>∈</mo><mi>D</mi><mo fence="true">}</mo></mrow><mo separator="true">,</mo><mspace width="2em"/><mi>X</mi><mo>=</mo><munder><mo>⋃</mo><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></munder><msub><mi>X</mi><mi>n</mi></msub><mo>=</mo><mi>μ</mi><mi>Y</mi><mi mathvariant="normal">.</mi><mrow><mo fence="true">(</mo><mi>S</mi><mo>∪</mo><mrow><mo fence="true">{</mo><mi>v</mi><mo>∣</mo><mi mathvariant="normal">∃</mi><mi>u</mi><mo>∈</mo><mi>Y</mi><mo>:</mo><mo stretchy="false">(</mo><mi>u</mi><mo separator="true">,</mo><mi>v</mi><mo stretchy="false">)</mo><mo>∈</mo><mi>D</mi><mo fence="true">}</mo></mrow><mo fence="true">)</mo></mrow><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">X&#95;0=S,&#92;qquad X&#95;{n+1}=X&#95;n&#92;cup&#92;left&#92;{v&#92;mid&#92;exists u&#92;in X&#95;n:(u,v)&#92;in D&#92;right&#92;},&#92;qquad X=&#92;bigcup&#95;{n&#92;geq 0}X&#95;n=&#92;mu Y.&#92;left(S&#92;cup&#92;left&#92;{v&#92;mid&#92;exists u&#92;in Y:(u,v)&#92;in D&#92;right&#92;}&#92;right).</annotation></semantics></math>
