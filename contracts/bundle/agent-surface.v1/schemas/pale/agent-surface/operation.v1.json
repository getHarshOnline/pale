{
  "$defs": {
    "OnDemandOperation": {
      "additionalProperties": false,
      "properties": {
        "capability_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageResourceLinkV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "capability_requirements": {
          "default": [],
          "items": {
            "$ref": "https://www.rawthoughts.in/pale/schemas/capability-procedure.v1.json#/$defs/OperationCapabilityRequirement"
          },
          "type": "array",
          "uniqueItems": true
        },
        "description": {
          "type": "string"
        },
        "doctrine": {
          "$ref": "#/$defs/OwnedConfinedRelativePath"
        },
        "doctrine_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PackageResourceLinkV1"
          },
          "type": "array"
        },
        "extends": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PackageResourceLinkV1"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/PackageResourceIdV1"
        },
        "outputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "roles": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PackageResourceLinkV1"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "description",
        "doctrine"
      ],
      "type": "object"
    },
    "OperationArchetype": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "doctrine": {
          "$ref": "#/$defs/OwnedConfinedRelativePath"
        },
        "doctrine_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PackageResourceLinkV1"
          },
          "type": "array"
        },
        "extends": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PackageResourceLinkV1"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/PackageResourceIdV1"
        }
      },
      "required": [
        "id",
        "description",
        "doctrine"
      ],
      "type": "object"
    },
    "OperationCatalog": {
      "additionalProperties": false,
      "properties": {
        "archetype": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OperationArchetype"
          },
          "type": "array"
        },
        "operation": {
          "items": {
            "$ref": "#/$defs/OnDemandOperation"
          },
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "operation"
      ],
      "type": "object"
    },
    "OwnedConfinedRelativePath": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "PackageIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "PackageResourceIdV1": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:[./][a-z][a-z0-9_-]*)*$",
      "type": "string"
    },
    "PackageResourceLinkV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "resource_id": {
              "$ref": "#/$defs/PackageResourceIdV1"
            },
            "scope": {
              "const": "local",
              "type": "string"
            }
          },
          "required": [
            "scope",
            "resource_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "resource": {
              "$ref": "#/$defs/PackageResourceRefV1"
            },
            "scope": {
              "const": "external",
              "type": "string"
            }
          },
          "required": [
            "scope",
            "resource"
          ],
          "type": "object"
        }
      ]
    },
    "PackageResourceRefV1": {
      "additionalProperties": false,
      "properties": {
        "package_id": {
          "$ref": "#/$defs/PackageIdV1"
        },
        "resource_id": {
          "$ref": "#/$defs/PackageResourceIdV1"
        }
      },
      "required": [
        "package_id",
        "resource_id"
      ],
      "type": "object"
    }
  },
  "$id": "https://www.rawthoughts.in/pale/schemas/operation.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "operations": {
      "$ref": "#/$defs/OperationCatalog"
    }
  },
  "required": [
    "operations"
  ],
  "title": "operation.v1",
  "type": "object"
}
