<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><msubsup><mi>B</mi><mrow><mi mathvariant="normal">c</mi><mi mathvariant="normal">o</mi><mi mathvariant="normal">n</mi><mi mathvariant="normal">t</mi><mi mathvariant="normal">r</mi><mi mathvariant="normal">o</mi><mi mathvariant="normal">l</mi></mrow><mrow><mi mathvariant="normal">c</mi><mi mathvariant="normal">o</mi><mi mathvariant="normal">p</mi><mi mathvariant="normal">y</mi></mrow></msubsup><mo stretchy="false">(</mo><mi>r</mi><mo separator="true">,</mo><mi>p</mi><mo separator="true">,</mo><mi>c</mi><mo separator="true">,</mo><mi>t</mi><mo stretchy="false">)</mo><mo>=</mo><mn>4</mn><mi>r</mi><mi>p</mi><mo>+</mo><mn>5</mn><mi>c</mi><mo>+</mo><mi>t</mi><mi>p</mi><mo separator="true">,</mo><mspace width="2em"/><mi>t</mi><mo>=</mo><mi>min</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>r</mi><mo>−</mo><mn>1</mn><mo separator="true">,</mo><msub><mi>T</mi><mi>max</mi><mo>⁡</mo></msub><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><msubsup><mi>B</mi><mrow><mi mathvariant="normal">d</mi><mi mathvariant="normal">i</mi><mi mathvariant="normal">r</mi><mi mathvariant="normal">e</mi><mi mathvariant="normal">c</mi><mi mathvariant="normal">t</mi></mrow><mrow><mi mathvariant="normal">c</mi><mi mathvariant="normal">o</mi><mi mathvariant="normal">p</mi><mi mathvariant="normal">y</mi></mrow></msubsup><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo><mo>=</mo><mn>2</mn><mi>p</mi><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">B&#95;{&#92;mathrm{control}}^{&#92;mathrm{copy}}(r,p,c,t)=4rp+5c+tp,&#92;qquad t=&#92;min(r-1,T&#95;{&#92;max}),&#92;qquad B&#95;{&#92;mathrm{direct}}^{&#92;mathrm{copy}}(p)=2p.</annotation></semantics></math>
